---
interface Props { title?: string; indent?: boolean | 1 | 2 }
const { title, indent = false } = Astro.props
const indentClass = indent === 2 ? 'pl-20' : indent ? 'pl-8' : ''
const gridColsClass = indent ? 'grid-cols-[2.5rem_1fr]' : 'grid-cols-[1.5rem_1fr]'
const trimmed = title?.trim() ?? ''
const hasTitle = trimmed.length > 0
const prefixMatch = trimmed.match(/^([A-Z][.\d]*)\s+(.+)$/)
const prefix = prefixMatch?.[1] ?? ''
const titleBody = prefixMatch?.[2] ?? trimmed
const proseClasses = "prose max-w-none [&>*:last-child]:mb-0 prose-p:text-text-primary prose-p:text-lg prose-p:leading-relaxed prose-p:mb-6 prose-headings:font-display prose-headings:font-bold prose-a:text-text-primary prose-a:underline prose-strong:text-text-primary prose-ul:pl-0 prose-ol:pl-0 prose-ul:my-6 prose-ol:my-6 prose-li:text-text-primary prose-li:text-lg prose-li:leading-relaxed prose-li:pl-0 prose-li:my-2 marker:text-text-primary [&_ul>li]:list-inside [&_ol>li]:list-inside [&_blockquote]:border-0 [&_blockquote]:pl-6 [&_blockquote]:my-8 [&_blockquote]:relative [&_blockquote]:not-italic [&_blockquote]:before:content-[''] [&_blockquote]:before:absolute [&_blockquote]:before:left-0 [&_blockquote]:before:top-0 [&_blockquote]:before:bottom-0 [&_blockquote]:before:w-1 [&_blockquote]:before:rounded-full [&_blockquote]:before:bg-gradient-accent prose-blockquote:font-display prose-blockquote:font-bold prose-blockquote:leading-snug prose-blockquote:text-text-primary [&_blockquote_p]:font-display [&_blockquote_p]:font-bold [&_blockquote_p]:not-italic [&_blockquote_p]:text-2xl [&_blockquote_p]:leading-snug [&_blockquote_p]:m-0 [&_blockquote_p]:before:content-none [&_blockquote_p]:after:content-none [&_blockquote_strong]:font-bold"
---
{prefix ? (
  <section class:list={['mb-6 [&:has(+section)]:mb-16 [&:has(+section.pl-8)]:mb-4 max-w-3xl grid gap-x-2', gridColsClass, indentClass]}>
    <h3 class="font-display font-bold text-lg md:text-xl text-text-primary mb-4 uppercase tracking-wide col-start-1">{prefix}</h3>
    <h3 class="font-display font-bold text-lg md:text-xl text-text-primary mb-4 uppercase tracking-wide col-start-2">{titleBody}</h3>
    <div class={`col-start-2 ${proseClasses}`}><slot /></div>
  </section>
) : (
  <section class:list={['mb-6 [&:has(+section)]:mb-16 [&:has(+section.pl-8)]:mb-4 max-w-3xl', indentClass]}>
    {hasTitle && <h3 class="font-display font-bold text-lg md:text-xl text-text-primary mb-4 uppercase tracking-wide">{trimmed}</h3>}
    <div class={proseClasses}><slot /></div>
  </section>
)}
