---
/* Case study text section — home styles (no Figma frame):
   - title: the Experience job title (18/29 → 24/38, white), no uppercase;
   - body: the Experience bullet text (14/22 mobile, 18/29 desktop, white),
     measure 720 on desktop as there;
   - bullets: the Experience 6px #6C6C71 dot in a 16px box, 4px gap;
   - quotes: the mobile Study Case card (container radius, Ficho; 1px #6C6C71, 23 + 1 padding)
     with the title style inside;
   - links: as the Contact e-mail (underline, #BBBBC0 on hover).
   Indent only from the desktop breakpoint (mobile has 354px to work with):
   24 or 48 per level, like Notion's nested blocks in the 720 reading column. */
interface Props { title?: string; indent?: boolean | 1 | 2 }
const { title, indent = false } = Astro.props
const indentClass = indent === 2 ? 'desktop:pl-(--space-48)' : indent ? 'desktop:pl-(--space-24)' : ''
const gridColsClass = indent ? 'grid-cols-[40px_1fr]' : 'grid-cols-[24px_1fr]'
const trimmed = title?.trim() ?? ''
const hasTitle = trimmed.length > 0
const prefixMatch = trimmed.match(/^([A-Z][.\d]*)\s+(.+)$/)
const prefix = prefixMatch?.[1] ?? ''
const titleBody = prefixMatch?.[2] ?? trimmed
const sectionClass = 'mb-(--space-24) [&:has(+section)]:mb-(--space-64) [&:has(+section[data-indent])]:mb-(--space-32)'
const titleClass = 'mb-(--space-12) text-title-md text-neutral-100 desktop:mb-(--space-16) desktop:text-title-lg'
---
{prefix ? (
  <section class:list={[sectionClass, 'grid gap-x-(--space-8)', gridColsClass, indentClass]} data-indent={indent ? '' : undefined}>
    <h3 class:list={[titleClass, 'col-start-1 text-neutral-600']}>{prefix}</h3>
    <h3 class:list={[titleClass, 'col-start-2']}>{titleBody}</h3>
    <div class="cs-prose col-start-2"><slot /></div>
  </section>
) : (
  <section class:list={[sectionClass, indentClass]} data-indent={indent ? '' : undefined}>
    {hasTitle && <h3 class={titleClass}>{trimmed}</h3>}
    <div class="cs-prose"><slot /></div>
  </section>
)}

<style is:global>
  /* Global: the children come from MDX, outside this component's scope. */
  .cs-prose {
    max-width: 720px; /* not in tokens: Experience bullet measure */
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--color-neutral-100);
  }
  .cs-prose > :last-child { margin-bottom: 0; }
  .cs-prose p { margin: 0 0 var(--space-16); }
  .cs-prose strong { font-weight: 600; }
  .cs-prose a {
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 200ms;
  }
  .cs-prose a:hover { color: var(--color-neutral-600); }
  .cs-prose ul,
  .cs-prose ol {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin: var(--space-16) 0;
    padding: 0;
    list-style: none;
  }
  .cs-prose li {
    position: relative;
    padding-left: 20px; /* 16px dot box + 4px gap, as Experience */
  }
  .cs-prose ul > li::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 8px;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--color-neutral-800);
  }
  .cs-prose ol { counter-reset: cs-ol; }
  .cs-prose ol > li { counter-increment: cs-ol; }
  .cs-prose ol > li::before {
    content: counter(cs-ol) '.';
    position: absolute;
    left: 0;
    color: var(--color-neutral-600);
  }
  .cs-prose blockquote {
    margin: var(--space-24) 0;
    padding: 23px; /* 24 with the 1px stroke inside, as the Study Case card */
    border: 1px solid var(--color-neutral-800);
    border-radius: var(--radius-container);
    font-size: var(--text-title-md);
    line-height: var(--text-title-md--line-height);
    font-weight: 600;
  }
  .cs-prose blockquote p { margin: 0; }
  .cs-prose blockquote p + p { margin-top: var(--space-12); }
  /* Tables: rows ruled like the Contact list / Project Snapshot. */
  .cs-prose table {
    width: 100%;
    margin: var(--space-24) 0;
    border-collapse: collapse;
    border-top: 1px solid var(--color-neutral-800);
  }
  .cs-prose tr { border-bottom: 1px solid var(--color-neutral-800); }
  .cs-prose th,
  .cs-prose td {
    padding: var(--space-12) var(--space-16) var(--space-12) 0;
    text-align: left;
    vertical-align: top;
  }
  .cs-prose th { font-weight: 400; color: var(--color-neutral-600); }

  @media (width >= 64rem) {
    .cs-prose {
      font-size: 18px; /* not in tokens: Experience desktop 18/29 */
      line-height: 29px;
    }
    .cs-prose p { margin-bottom: var(--space-20); }
    .cs-prose ul,
    .cs-prose ol { margin: var(--space-20) 0; }
    .cs-prose ul > li::before { top: 11.5px; }
    .cs-prose blockquote {
      font-size: var(--text-title-lg);
      line-height: var(--text-title-lg--line-height);
    }
  }
</style>
