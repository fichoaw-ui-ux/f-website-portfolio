---
/* Case study text section — home styles (no Figma frame):
   - title: sized by nesting level (Ficho: sub-points read smaller), from the
     home title scale, mobile → desktop:
       level 1  "A.", "Kickoff"        Title/Medium 18/29 → Title/Large 24/38
       level 2  "A.1"                  Title/X-Medium 16/26 → Title/X-Large 20/32
       level 3  "A.1.1" / deeper       Title/X-Medium 16/26 → Title/Medium 18/29
     The level is the prefix depth ("A.1" = 2); an un-numbered title takes it
     from its indent (none 1, indent 2, indent={2} 3). `level` overrides both;
   - body: the Experience bullet text (14/22 mobile, 18/29 desktop, white),
     measure 720 on desktop as there;
   - bullets: the Experience 6px #6C6C71 dot in a 16px box, 4px gap;
   - quotes: the mobile Study Case card (container radius, Ficho; 1px #6C6C71, 23 + 1 padding)
     with the title style inside;
   - links: as the Contact e-mail (underline, #BBBBC0 on hover).
   Indent: the shared rule in ./indent.ts (desktop 0 / 32 / 80), so a child
   section's heading and every asset start where the parent's text starts.
   The "A." / "A.1" prefix hangs in its own column on desktop (24 at level 1,
   40 when indented, + 8 gap) and sits inline on mobile, where nothing is
   indented and all text starts at 0. */
import { indentPadding, type Indent } from './indent'

interface Props { title?: string; indent?: Indent; level?: 1 | 2 | 3 }
const { title, indent = false, level: levelProp } = Astro.props
const indentClass = indentPadding(indent)
const trimmed = title?.trim() ?? ''
const hasTitle = trimmed.length > 0
// "A." / "A.1" for decisions, "1." for numbered sub-sections (Ficho).
const prefixMatch = trimmed.match(/^([A-Z][.\d]*|\d+\.)\s+(.+)$/)
const prefix = prefixMatch?.[1] ?? ''
const titleBody = prefixMatch?.[2] ?? trimmed
// Prefix column: 24 for one-character numbers ("A.", "1."), 40 for "A.1";
// + gap 8 (not in tokens: the sums in ./indent.ts).
const widePrefix = prefix.replace('.', '').length > 1
const prefixWidth = widePrefix ? 'desktop:w-[40px]' : 'desktop:w-(--space-24)'
const bodyOffset = widePrefix ? 'desktop:ml-(--space-48)' : 'desktop:ml-(--space-32)'
const prefixDepth = prefix ? prefix.split('.').filter(Boolean).length : 0
const level = Math.min(levelProp ?? (prefixDepth || (indent === 2 ? 3 : indent ? 2 : 1)), 3)
const Heading = (['h3', 'h4', 'h5'] as const)[level - 1]
const titleSize = [
  'text-title-md desktop:text-title-lg',
  'text-title-xmd desktop:text-title-xl',
  'text-title-xmd desktop:text-title-md',
][level - 1]
// Gaps = home scale (CaseStudyLayout): block 24/32, sub-section 32/40; an indented
// continuation is a block of the same sub-section. Text → asset (image, image
// grid, prototype; marked data-asset) is 24 on every breakpoint (Ficho: 32 read
// as a break between the text and the asset it introduces). An asset followed
// by a new titled section (data-titled, not indented) takes the sub-section gap
// 32/40 too (Ficho), set on the asset components.
// Text → a titled sub-section (data-sub: level 2+, e.g. A → A.1, or "1." under
// an un-numbered section) is 24 on every breakpoint (Ficho). "1." under an
// un-numbered section steps in 16 (indent "sub"), its text and assets 48
// (indent "subText").
const sectionClass = 'mb-(--space-24) desktop:mb-(--space-32) [&:has(+section)]:mb-(--space-32) desktop:[&:has(+section)]:mb-(--space-40) [&:has(+section[data-indent])]:mb-(--space-24) desktop:[&:has(+section[data-indent])]:mb-(--space-32) desktop:[&:has(+[data-asset])]:mb-(--space-24) [&:has(+section[data-sub][data-titled])]:mb-(--space-24) desktop:[&:has(+section[data-sub][data-titled])]:mb-(--space-24)'
const titleClass = `mb-(--space-12) text-neutral-100 desktop:mb-(--space-16) ${titleSize}`
---
{prefix ? (
  <section class:list={[sectionClass, indentClass]} data-indent={indent ? '' : undefined} data-sub={level > 1 ? '' : undefined} data-titled>
    <Heading class:list={[titleClass, 'flex gap-x-(--space-8)']} data-motion="lines">
      <span class:list={['shrink-0 text-neutral-600', prefixWidth]}>{prefix}</span>
      <span class="min-w-0">{titleBody}</span>
    </Heading>
    <div class:list={['cs-prose', bodyOffset]} data-motion="rise"><slot /></div>
  </section>
) : (
  <section class:list={[sectionClass, indentClass]} data-indent={indent ? '' : undefined} data-sub={hasTitle && level > 1 ? '' : undefined} data-titled={hasTitle ? '' : undefined}>
    {hasTitle && <Heading class={titleClass} data-motion="lines">{trimmed}</Heading>}
    <div class="cs-prose" data-motion="rise"><slot /></div>
  </section>
)}

<style is:global>
  /* Global: the children come from MDX, outside this component's scope. */
  .cs-prose {
    max-width: 720px; /* not in tokens: Experience bullet measure */
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--color-neutral-100);
  }
  .cs-prose > :last-child { margin-bottom: 0; }
  .cs-prose p { margin: 0 0 var(--space-16); }
  .cs-prose strong { font-weight: 600; }
  .cs-prose a {
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 200ms;
  }
  .cs-prose a:hover { color: var(--color-neutral-600); }
  .cs-prose ul,
  .cs-prose ol {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin: var(--space-16) 0;
    padding: 0;
    list-style: none;
  }
  .cs-prose li {
    position: relative;
    padding-left: 20px; /* 16px dot box + 4px gap, as Experience */
  }
  .cs-prose ul > li::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 8px;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--color-neutral-800);
  }
  .cs-prose ol { counter-reset: cs-ol; }
  .cs-prose ol > li { counter-increment: cs-ol; }
  .cs-prose ol > li::before {
    content: counter(cs-ol) '.';
    position: absolute;
    left: 0;
    color: var(--color-neutral-600);
  }
  .cs-prose blockquote {
    margin: var(--space-24) 0; /* block gap; 32 on desktop */
    padding: 23px; /* 24 with the 1px stroke inside, as the Study Case card */
    border: 1px solid var(--color-neutral-800);
    border-radius: var(--radius-container);
    font-size: var(--text-title-md);
    line-height: var(--text-title-md--line-height);
    font-weight: 600;
  }
  .cs-prose blockquote p { margin: 0; }
  .cs-prose blockquote p + p { margin-top: var(--space-12); }
  /* Tables: rows ruled like the Contact list / Project Snapshot. */
  .cs-prose table {
    width: 100%;
    margin: var(--space-24) 0; /* block gap; 32 on desktop */
    border-collapse: collapse;
    border-top: 1px solid var(--color-neutral-800);
  }
  .cs-prose tr { border-bottom: 1px solid var(--color-neutral-800); }
  .cs-prose th,
  .cs-prose td {
    padding: var(--space-12) var(--space-16);
    text-align: left;
    vertical-align: top;
  }
  /* Header row and first column read as headers (Ficho): light neutral-800
     fill, white semibold. Cells are padded 16 on both sides so text clears
     the fill. */
  .cs-prose th,
  .cs-prose td:first-child {
    background: color-mix(in srgb, var(--color-neutral-800) 40%, transparent); /* not in tokens: neutral-800 at 40% (Ficho) */
    font-weight: 600;
    color: var(--color-neutral-100);
  }

  @media (width >= 64rem) {
    .cs-prose {
      font-size: 18px; /* not in tokens: Experience desktop 18/29 */
      line-height: 29px;
    }
    .cs-prose ul,
    .cs-prose ol { margin: var(--space-16) 0; }
    .cs-prose blockquote,
    .cs-prose table { margin: var(--space-32) 0; }
    .cs-prose ul > li::before { top: 11.5px; }
    .cs-prose blockquote {
      font-size: var(--text-title-lg);
      line-height: var(--text-title-lg--line-height);
    }
  }
</style>
