---
import { resolveLocale, useTranslations } from '../../i18n/ui'

interface Props { src: string; alt: string; caption?: string; label?: string; indent?: boolean | 1 | 2; mobile?: boolean }
const lang = resolveLocale(Astro.currentLocale)
const t = useTranslations(lang)
const { src, alt, caption, label, indent = false, mobile = false } = Astro.props
const indentClass = indent === 2 ? 'md:pl-20' : indent ? 'md:pl-8' : ''
const isPlaceholder = src.includes('placeholder')
const resolvedLabel = isPlaceholder ? t.imageFull.placeholderLabel : (label ?? t.imageFull.imageLabel)

let title = caption
let description = ''
if (caption) {
  const match = caption.match(/^([^.!?]+[.!?])\s+(.+)$/s)
  if (match) {
    title = match[1]
    description = match[2]
  }
}
---
<figure class:list={['mb-12', indentClass]}>
  <div class="overflow-hidden rounded-media stroke-gradient [--stroke-fill:var(--gradient-card)]">
    <div class="flex items-center justify-between gap-4 border-b border-border px-4 py-3">
      <div class="flex min-w-0 items-center gap-2">
        <span class="shrink-0 font-mono text-xs uppercase tracking-widest text-text-tertiary">{resolvedLabel}</span>
        {title && <span class="truncate font-mono text-sm text-text-primary">{title}</span>}
      </div>
      {!isPlaceholder && <button type="button" data-lightbox-trigger data-lightbox-src={src} data-lightbox-alt={alt} class="shrink-0 cursor-pointer font-mono text-xs uppercase tracking-widest text-text-tertiary transition hover:text-text-primary">{t.imageFull.viewFull}</button>}
    </div>
    {mobile ? (
      <div class="flex justify-center bg-bg-primary py-6">
        <img src={src} alt={alt} class="block h-auto w-full max-w-[320px]" loading="lazy" />
      </div>
    ) : (
      <img src={src} alt={alt} class="block h-auto w-full" loading="lazy" />
    )}
    {description && (
      <div class="border-t border-border px-4 py-3">
        <span class="font-mono text-sm text-text-primary">{description}</span>
      </div>
    )}
  </div>
</figure>
