---
interface Props { items: { value: string; label: string }[] }
const { items } = Astro.props
---
<div class="mb-12 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
  {items.map(m => (
    <div class="p-6 rounded-lg bg-bg-secondary border border-border">
      <div class="font-display font-black text-4xl md:text-5xl text-text-primary">{m.value}</div>
      <div class="mt-2 font-mono text-sm uppercase tracking-widest text-text-secondary">{m.label}</div>
    </div>
  ))}
</div>
