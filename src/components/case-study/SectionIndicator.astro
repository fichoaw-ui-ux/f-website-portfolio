---
---
<div id="section-indicator" class="fixed left-0 right-0 z-30 opacity-0 pointer-events-none transition-opacity duration-200 bg-bg-primary/95 backdrop-blur border-b border-border" style="top: var(--header-h, 57px);">
  <div class="mx-auto max-w-[1120px] px-6 md:px-8 py-3">
    <nav id="section-indicator-nav" class="flex items-center justify-between gap-4 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"></nav>
  </div>
  <div class="absolute left-0 right-0 bottom-0 h-[3px] bg-border/40 overflow-hidden">
    <div id="section-indicator-progress" class="h-full bg-gradient-accent origin-left" style="transform: scaleX(0); width: 100%;"></div>
  </div>
</div>

<script>
  const indicator = document.getElementById('section-indicator');
  const navEl = document.getElementById('section-indicator-nav');
  const progressEl = document.getElementById('section-indicator-progress');
  const header = document.querySelector('header');
  const article = document.querySelector('article');
  const boundaries = Array.from(document.querySelectorAll('[data-part-header]')) as HTMLElement[];

  if (indicator && navEl && progressEl && boundaries.length) {
    const headerH = header ? header.getBoundingClientRect().height : 57;
    document.documentElement.style.setProperty('--header-h', `${Math.round(headerH)}px`);
    const offset = headerH + 8;

    boundaries.forEach((b, i) => {
      if (!b.id) b.id = `part-${i + 1}`;
      const num = b.dataset.partNum || '';
      const title = b.dataset.partTitle || '';
      const link = document.createElement('a');
      link.href = `#${b.id}`;
      link.className = 'section-nav-item shrink-0 flex items-baseline gap-2 transition group';
      link.dataset.index = String(i);
      link.innerHTML = `
        <span class="section-nav-num font-display font-bold text-sm md:text-base transition" style="color: var(--color-text-secondary);">${num}</span>
        <span class="section-nav-title font-mono text-xs uppercase tracking-widest transition whitespace-nowrap" style="color: var(--color-text-secondary);">${title}</span>
      `;
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const target = document.getElementById(b.id);
        if (target) {
          const y = target.getBoundingClientRect().top + window.scrollY - offset - 8;
          window.scrollTo({ top: y, behavior: 'smooth' });
        }
      });
      navEl.appendChild(link);
    });

    const navItems = Array.from(navEl.querySelectorAll('.section-nav-item')) as HTMLElement[];

    let current: HTMLElement | null = null;

    function update() {
      let latest: HTMLElement | null = null;
      boundaries.forEach((b) => {
        const top = b.getBoundingClientRect().top;
        if (top < offset) latest = b;
      });

      if (latest !== current) {
        current = latest;
        if (current) {
          indicator!.classList.remove('opacity-0', 'pointer-events-none');
          indicator!.classList.add('opacity-100');
        } else {
          indicator!.classList.add('opacity-0', 'pointer-events-none');
          indicator!.classList.remove('opacity-100');
        }
        const currentEl = current;
        const currentIdx = currentEl ? boundaries.indexOf(currentEl) : -1;
        navItems.forEach((item, i) => {
          const num = item.querySelector('.section-nav-num') as HTMLElement;
          const title = item.querySelector('.section-nav-title') as HTMLElement;
          item.classList.remove('active', 'finished');
          if (i === currentIdx) {
            item.classList.add('active');
            num.style.color = 'var(--color-accent)';
            title.style.color = 'var(--color-accent)';
            title.style.fontWeight = '700';
            num.style.fontSize = '18px';
            title.style.fontSize = '14px';
          } else if (i < currentIdx) {
            item.classList.add('finished');
            num.style.color = 'var(--color-text-primary)';
            title.style.color = 'var(--color-text-primary)';
            title.style.fontWeight = '';
            num.style.fontSize = '';
            title.style.fontSize = '';
          } else {
            num.style.color = 'var(--color-text-secondary)';
            title.style.color = 'var(--color-text-secondary)';
            title.style.fontWeight = '';
            num.style.fontSize = '';
            title.style.fontSize = '';
          }
        });

        const activeItem = navItems.find((i) => i.classList.contains('active'));
        if (activeItem && navEl) {
          const itemRect = activeItem.getBoundingClientRect();
          const navRect = navEl.getBoundingClientRect();
          if (itemRect.left < navRect.left || itemRect.right > navRect.right) {
            activeItem.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
          }
        }
      }

      if (article) {
        const rect = article.getBoundingClientRect();
        const articleTop = rect.top + window.scrollY;
        const articleH = rect.height;
        const viewportH = window.innerHeight;
        const scrolled = window.scrollY - articleTop + viewportH;
        const total = articleH;
        const progress = Math.max(0, Math.min(1, scrolled / total));
        progressEl!.style.transform = `scaleX(${progress})`;
      }
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
