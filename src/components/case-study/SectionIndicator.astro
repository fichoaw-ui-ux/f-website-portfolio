---
---
{/* Styled as the home tab bar while stuck (#252525/88 + blur, 1px #6C6C71
    rule): inactive #BBBBC0 Body/Small, active white SemiBold. No Figma frame. */}
<div id="section-indicator" class="fixed inset-x-0 bottom-0 z-30 mx-auto max-w-[402px] border-t border-neutral-800 bg-neutral-900/88 opacity-0 pointer-events-none backdrop-blur-lg transition-opacity duration-200 desktop:max-w-none">
  <div class="mx-auto flex h-[56px] max-w-[1088px] items-center px-(--space-24) desktop:h-[68px]">
    <nav id="section-indicator-nav" class="flex w-full items-center justify-between gap-(--space-24) overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"></nav>
  </div>
  <div class="absolute inset-x-0 bottom-0 h-[2px] overflow-hidden bg-neutral-800">
    <div id="section-indicator-progress" class="h-full origin-left bg-neutral-100" style="transform: scaleX(0); width: 100%;"></div>
  </div>
</div>

<script>
  const indicator = document.getElementById('section-indicator');
  const navEl = document.getElementById('section-indicator-nav');
  const progressEl = document.getElementById('section-indicator-progress');
  // Site nav header only. Case studies also have an <article><header> for the
  // page title, which is not what we want to measure — that's a tall content
  // block, and using its height pushed the progress bar into the middle of the
  // viewport once the site header was removed from case-study pages.
  const header = document.querySelector('[data-case-header]');
  const article = document.querySelector('article');
  const boundaries = Array.from(document.querySelectorAll('[data-part-header]')) as HTMLElement[];

  if (indicator && navEl && progressEl && boundaries.length) {
    const headerH = header ? header.getBoundingClientRect().height : 0;
    document.documentElement.style.setProperty('--header-h', `${Math.round(headerH)}px`);
    const offset = headerH + 8;

    boundaries.forEach((b, i) => {
      if (!b.id) b.id = `part-${i + 1}`;
      const num = b.dataset.partNum || '';
      const title = b.dataset.partTitle || '';
      const link = document.createElement('a');
      link.href = `#${b.id}`;
      link.className = 'section-nav-item group flex shrink-0 items-baseline gap-(--space-6) text-body-sm transition-colors duration-200 desktop:text-button-md desktop:font-normal';
      link.dataset.index = String(i);
      link.innerHTML = `
        <span class="section-nav-num">${num}</span>
        <span class="section-nav-title whitespace-nowrap">${title}</span>
      `;
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const target = document.getElementById(b.id);
        if (target) {
          const y = target.getBoundingClientRect().top + window.scrollY - offset - 8;
          window.scrollTo({ top: y, behavior: 'smooth' });
        }
      });
      navEl.appendChild(link);
    });

    const navItems = Array.from(navEl.querySelectorAll('.section-nav-item')) as HTMLElement[];

    let current: HTMLElement | null = null;

    function update() {
      let latest: HTMLElement | null = null;
      boundaries.forEach((b) => {
        const top = b.getBoundingClientRect().top;
        if (top < offset) latest = b;
      });

      if (latest !== current) {
        current = latest;
        if (current) {
          indicator!.classList.remove('opacity-0', 'pointer-events-none');
          indicator!.classList.add('opacity-100');
        } else {
          indicator!.classList.add('opacity-0', 'pointer-events-none');
          indicator!.classList.remove('opacity-100');
        }
        const currentEl = current;
        const currentIdx = currentEl ? boundaries.indexOf(currentEl) : -1;
        navItems.forEach((item, i) => {
          item.classList.toggle('active', i === currentIdx);
          item.classList.toggle('finished', i < currentIdx);
        });

        const activeItem = navItems.find((i) => i.classList.contains('active'));
        if (activeItem && navEl) {
          const itemRect = activeItem.getBoundingClientRect();
          const navRect = navEl.getBoundingClientRect();
          if (itemRect.left < navRect.left || itemRect.right > navRect.right) {
            activeItem.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
          }
        }
      }

      if (article) {
        const rect = article.getBoundingClientRect();
        const articleTop = rect.top + window.scrollY;
        const articleH = rect.height;
        const viewportH = window.innerHeight;
        const scrolled = window.scrollY - articleTop + viewportH;
        const total = articleH;
        const progress = Math.max(0, Math.min(1, scrolled / total));
        progressEl!.style.transform = `scaleX(${progress})`;
      }
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>

<style is:global>
  /* As the home tabs: upcoming #BBBBC0, passed white, current white SemiBold. */
  .section-nav-item { color: var(--color-neutral-600); }
  .section-nav-item.finished { color: var(--color-neutral-100); }
  .section-nav-item.active { color: var(--color-neutral-100); font-weight: 600; }
  @media (hover: hover) {
    .section-nav-item:not(.active):hover { color: var(--color-neutral-100); }
  }
</style>
