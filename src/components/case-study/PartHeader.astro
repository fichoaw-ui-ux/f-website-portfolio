---
interface Props { number: string; title: string }
const { number, title } = Astro.props
const n = String(parseInt(number, 10))
---
<div class="mt-24 mb-8 pt-12 border-t border-border" data-part-header data-part-num={`${n}.`} data-part-title={title}>
  <h2 class="font-display font-bold text-4xl md:text-5xl text-gradient-accent leading-tight">{n}. {title}</h2>
</div>
