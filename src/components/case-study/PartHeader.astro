---
interface Props { number: string; title: string }
const { number, title } = Astro.props
---
<div class="mt-32 mb-12 pt-12 border-t border-border">
  <div class="font-mono text-sm uppercase tracking-widest text-text-secondary mb-4">{number}</div>
  <h2 class="font-display font-bold text-display-lg">{title}</h2>
</div>
