---
/* Figma prototype frame — same frame as ImageFull (home styles). */
import { resolveLocale, useTranslations } from '../../i18n/ui'

interface Props { url: string; title?: string; caption?: string; indent?: boolean | 1 | 2 }
const lang = resolveLocale(Astro.currentLocale)
const t = useTranslations(lang)
const { url, title = t.figmaEmbed.defaultTitle, caption, indent = false } = Astro.props
const indentClass = indent === 2 ? 'desktop:pl-(--space-48)' : indent ? 'desktop:pl-(--space-24)' : ''
const cleanUrl = url.replace(/[?&]show-proto-sidebar=[^&]*/g, '')
const sep = cleanUrl.includes('?') ? '&' : '?'
const protoUrl = `${cleanUrl}${sep}show-proto-sidebar=0`
const embedUrl = `https://www.figma.com/embed?embed_host=share&url=${encodeURIComponent(protoUrl)}`
---
<figure class:list={['mb-(--space-48)', indentClass]}>
  <div class="overflow-hidden rounded-(--radius-24) border border-neutral-800">
    <div class="flex items-center justify-between gap-(--space-16) border-b border-neutral-800 px-(--space-16) py-(--space-12)">
      <div class="flex min-w-0 items-center gap-(--space-8)">
        <span class="shrink-0 text-button-sm text-neutral-600">{t.figmaEmbed.prototypeLabel}</span>
        <span class="truncate text-body-sm text-neutral-100">{title}</span>
      </div>
      <a href={url} target="_blank" rel="noopener" class="shrink-0 cursor-pointer text-button-sm text-neutral-600 transition-colors duration-200 hover:text-neutral-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-100">{t.figmaEmbed.openInFigma}</a>
    </div>
    <iframe
      src={embedUrl}
      title={title}
      loading="lazy"
      allowfullscreen
      class="block w-full"
      style="height: 600px; border: 0;"
    ></iframe>
  </div>
  {caption && <figcaption class="mt-(--space-12) text-center text-body-sm text-neutral-600">{caption}</figcaption>}
</figure>
