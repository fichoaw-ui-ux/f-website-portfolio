---
import { resolveLocale, useTranslations } from '../../i18n/ui'

interface Props { url: string; title?: string; caption?: string; indent?: boolean | 1 | 2 }
const lang = resolveLocale(Astro.currentLocale)
const t = useTranslations(lang)
const { url, title = t.figmaEmbed.defaultTitle, caption, indent = false } = Astro.props
const indentClass = indent === 2 ? 'md:pl-20' : indent ? 'md:pl-8' : ''
const cleanUrl = url.replace(/[?&]show-proto-sidebar=[^&]*/g, '')
const sep = cleanUrl.includes('?') ? '&' : '?'
const protoUrl = `${cleanUrl}${sep}show-proto-sidebar=0`
const embedUrl = `https://www.figma.com/embed?embed_host=share&url=${encodeURIComponent(protoUrl)}`
---
<figure class:list={['mb-12', indentClass]}>
  <div class="overflow-hidden rounded-media stroke-gradient [--stroke-fill:var(--gradient-card)]">
    <div class="flex items-center justify-between gap-4 border-b border-border px-4 py-3">
      <div class="flex min-w-0 items-center gap-2">
        <span class="font-mono text-xs uppercase tracking-widest text-text-tertiary">{t.figmaEmbed.prototypeLabel}</span>
        <span class="truncate font-mono text-sm text-text-primary">{title}</span>
      </div>
      <a href={url} target="_blank" rel="noopener" class="shrink-0 font-mono text-xs uppercase tracking-widest text-text-tertiary transition hover:text-text-primary">{t.figmaEmbed.openInFigma}</a>
    </div>
    <iframe
      src={embedUrl}
      title={title}
      loading="lazy"
      allowfullscreen
      class="block w-full"
      style="height: 600px; border: 0;"
    ></iframe>
  </div>
  {caption && <figcaption class="mt-4 text-center font-mono text-base text-text-tertiary">{caption}</figcaption>}
</figure>
