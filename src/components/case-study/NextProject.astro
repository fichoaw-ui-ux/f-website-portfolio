---
import { resolveLocale, useTranslations } from '../../i18n/ui'
import { getRelativeLocaleUrl } from 'astro:i18n'

interface Props {
  slug: string
  title: string
  cover: string
  coverAlt: string
}
const { slug, title, cover, coverAlt } = Astro.props
const lang = resolveLocale(Astro.currentLocale)
const t = useTranslations(lang)
---
<div class="mt-24">
  <div class="mb-6 font-mono text-sm uppercase tracking-widest text-text-tertiary">{t.caseStudy.nextProject}</div>
  <a
    href={getRelativeLocaleUrl(lang, `/work/${slug}`)}
    class="group block rounded-[32px] glass p-6 transition duration-500 hover:-translate-y-1 md:p-12"
  >
    <div class="grid items-center gap-8 lg:grid-cols-[36%_1fr] lg:items-stretch lg:gap-12">
      <div class="order-2 lg:order-1">
        <h3 class="font-display font-semibold text-display-md text-text-primary">{title}</h3>
        <span
          class="mt-8 inline-flex h-12 items-center gap-2 rounded-full glass px-5 text-base font-semibold leading-none text-text-primary transition duration-300 group-hover:[--stroke-fill:linear-gradient(var(--color-bg-elevated),var(--color-bg-elevated))]"
        >
          <span>{t.common.viewDetails}</span>
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="m13 5 7 7-7 7" />
          </svg>
        </span>
      </div>
      <div class="order-1 aspect-[730/438] overflow-hidden rounded-media bg-bg-primary lg:order-2 lg:aspect-auto lg:h-full">
        <img
          src={cover}
          alt={coverAlt}
          class="h-full w-full object-cover grayscale transition duration-500 group-hover:scale-[1.02] group-hover:grayscale-0"
        />
      </div>
    </div>
  </a>
</div>
