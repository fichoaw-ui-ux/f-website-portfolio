---
interface Props { cols?: 2 | 3; indent?: boolean | 1 | 2 }
const { cols = 2, indent = false } = Astro.props
const colClass = cols === 3 ? 'desktop:grid-cols-3' : 'desktop:grid-cols-2'
const indentClass = indent === 2 ? 'desktop:pl-(--space-48)' : indent ? 'desktop:pl-(--space-24)' : ''
---
<div class:list={['mb-(--space-48) grid grid-cols-1 gap-(--space-24) [&>figure]:mb-0', colClass, indentClass]}><slot /></div>
