---
interface Props { class?: string }
const { class: className = '' } = Astro.props
---
<span
  class:list={[
    'inline-flex h-10 items-center px-5 text-base font-semibold leading-none rounded-full stroke-gradient [--stroke-fill:var(--gradient-card)] text-text-primary',
    className,
  ]}
><slot /></span>
