---
/* Footer — Figma Draft: desktop `8:382`, mobile `8:874`.
   Desktop: 1px top rule (in layout: 1 + 28 + 26 + 28 = 83), copyright left.
   Mobile: no rule (the frame has a top weight but no stroke paint), 24px
   padding, copyright centred (74 tall).
   Used on redesigned pages only; the legacy Footer stays on the light case
   study pages, where #BBBBC0 on white would not read. */
import ContentBand from './ContentBand.astro'
import { getSite } from '../../content/site'
import { resolveLocale, useTranslations } from '../../i18n/ui'

const year = new Date().getFullYear()
const lang = resolveLocale(Astro.currentLocale)
const site = getSite(lang)
const t = useTranslations(lang)
---
<footer class="py-(--space-24) desktop:border-t desktop:border-neutral-800 desktop:py-(--space-28)" data-figma="footer" data-motion="rise" data-motion-distance="sm">
  <ContentBand>
    <p class="text-center text-title-xmd text-neutral-600 desktop:text-left">&copy; {year} {site.name}. {t.footer.rights}</p>
  </ContentBand>
</footer>
