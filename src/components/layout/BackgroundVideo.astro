---
/* Full-viewport looping sky behind every dark page. Rendered from the
   "Storm light" preset (FeralUI gradient studio, 10s seamless loop, 30fps),
   then re-encoded from the 9 MB export to ~1.2 MB HEVC / ~1.8 MB H.264.
   HEVC is listed first for Safari and hardware-decoding Chromium; browsers
   that cannot play it fall through to H.264.

   Storm light's crests are near-white (#E8EAEE) while the site's text is
   white, so the scrim darkens the footage toward --color-bg-primary until the
   text tiers clear contrast again. Tune its opacity, not the video. */
---
<div class="bg-video" aria-hidden="true">
  <video autoplay muted loop playsinline preload="auto" poster="/images/bg-storm-light-poster.jpg">
    <source src="/videos/bg-storm-light-hevc.mp4" type='video/mp4; codecs="hvc1"' />
    <source src="/videos/bg-storm-light.mp4" type="video/mp4" />
  </video>
</div>

<style>
  /* z-index -3 sits under body::before (-2) and the grain (-1), so the soft
     light patches and grain still paint over the footage. It paints above
     body's own background because body is `isolation: isolate` (global.css). */
  .bg-video {
    position: fixed;
    inset: 0;
    z-index: -3;
    pointer-events: none;
    background: url('/images/bg-storm-light-poster.jpg') center / cover no-repeat;
  }
  .bg-video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .bg-video::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Redesigned pages swap the scrim to the redesign's #252525 at a higher
       opacity through these two variables (global.css, [data-redesign]). */
    background: var(--bg-video-scrim, var(--color-bg-primary));
    opacity: var(--bg-video-scrim-opacity, 0.72);
  }

  /* Reduced motion keeps the still poster (the wrapper's background) and
     drops the moving footage. */
  @media (prefers-reduced-motion: reduce) {
    .bg-video video {
      display: none;
    }
  }
</style>
