---
import Container from './Container.astro'
import { site } from '../../content/site'
---
{/* Not sticky, and no bar. Figma draws neither, and the two go together: a
    sticky header without a background scrolls transparently over the content,
    which put 88px headings underneath the wordmark. With the nav links gone
    the only thing left to pin is the Contact CTA, and that is duplicated in
    the Contact section. */}
<header class="pt-8">
  <Container>
    <div class="flex h-[72px] items-center justify-between gap-3">
      {/* The accessible name lives on the link, so the image is decorative —
          naming both would make the link announce itself twice. */}
      <a href="/" class="inline-flex items-center" aria-label={`${site.name} — home`}>
        <img src="/images/logo-ficho.svg" alt="" width="106" height="32" class="h-8 w-auto" />
      </a>

      <a
        href={`mailto:${site.email}`}
        class="inline-flex h-12 items-center gap-2 rounded-full border border-border px-5 text-base font-semibold leading-none text-text-primary transition duration-300 hover:border-border-hover hover:bg-bg-elevated"
      >
        <span>Contact Us</span>
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m13 5 7 7-7 7" />
        </svg>
      </a>
    </div>
  </Container>
</header>
