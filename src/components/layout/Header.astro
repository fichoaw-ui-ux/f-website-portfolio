---
import Container from './Container.astro'
import { site } from '../../content/site'
---
<header class="sticky top-4 z-40 px-4">
  <Container class="!px-0">
    <div class="flex items-center justify-between gap-3 rounded-full bg-bg-secondary/85 backdrop-blur-md border border-border pl-6 pr-3 py-3 shadow-[0_8px_24px_-8px_rgba(0,0,0,0.15)]">
      <a href="/" class="font-display font-black text-lg tracking-tight text-text-primary">{site.name}</a>

      <div class="flex items-center gap-1">
        <nav class="hidden md:flex items-center gap-1 mr-1">
          <a href="/#work" class="px-4 py-2 rounded-full text-sm text-text-secondary hover:text-text-primary hover:bg-bg-elevated transition">Work</a>
          <a href="/#about" class="px-4 py-2 rounded-full text-sm text-text-secondary hover:text-text-primary hover:bg-bg-elevated transition">About</a>
          <a href="/#contact" class="px-4 py-2 rounded-full text-sm text-text-secondary hover:text-text-primary hover:bg-bg-elevated transition">Contact</a>
        </nav>

        <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 rounded-full bg-text-primary text-bg-primary pl-4 pr-3 py-3 text-sm shadow-[0_8px_16px_-4px_rgba(0,0,0,0.2)] hover:bg-text-secondary transition">
          <span>Get in touch</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/>
            <path d="m13 5 7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </Container>
</header>
