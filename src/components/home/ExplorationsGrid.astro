---
import { getCollection } from 'astro:content'
import Container from '../layout/Container.astro'
import Reveal from '../ui/Reveal.astro'
import Pill from '../ui/Pill.astro'
import { sortByOrder, localeEntries } from '../../lib/content'
import { resolveLocale, useTranslations } from '../../i18n/ui'

const lang = resolveLocale(Astro.currentLocale)
const t = useTranslations(lang)
const all = await getCollection('explorations')
const items = sortByOrder(localeEntries(all, lang))

/* Three consecutive chunks, not round-robin. Staggered columns need real
   column containers — a plain grid cannot offset one column without moving the
   shared row — so DOM order is whatever the split produces. Chunking keeps DOM
   order equal to content order, which is what the single-column mobile layout
   stacks and what a screen reader announces. Round-robin would emit 1, 4, 2,
   5, 3, 6.

   Column sizes follow a 2-3-2 rhythm — the middle column carries one extra
   card so the staggered layout stays visually balanced. Any overflow past
   seven items spills into the middle column. */
const sideCount = Math.floor((items.length - 1) / 3)
const columns = [
  items.slice(0, sideCount),
  items.slice(sideCount, items.length - sideCount),
  items.slice(items.length - sideCount),
]

// Precompute the sandboxed embed src for any exploration that has a prototype.
// The card exposes it via a data attribute; the modal script reads it on click.
function embedSrc(url: string) {
  const cleanUrl = url.replace(/[?&]show-proto-sidebar=[^&]*/g, '')
  const sep = cleanUrl.includes('?') ? '&' : '?'
  const protoUrl = `${cleanUrl}${sep}show-proto-sidebar=0`
  return `https://www.figma.com/embed?embed_host=share&url=${encodeURIComponent(protoUrl)}`
}
---
<section id="explorations" class="py-section-y-sm md:py-section-y scroll-mt-32">
  <Container>
    {items.length === 0 ? (
      <p class="text-text-tertiary">{t.exploration.noExplorations}</p>
    ) : (
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
        {columns.map((column, ci) => (
          <div class:list={['flex flex-col gap-8', ci !== 1 && 'lg:mt-[276px]']}>
            {column.map(e => {
              // With a prototype: the primary action opens the modal.
              // Without: the primary action links to the detail page.
              // If liveUrl is set, a second pill links to the live site.
              // Keeping the two actions as sibling elements (rather than a
              // nested <a> inside <button>) — nesting interactive elements is
              // invalid HTML and breaks keyboard focus order.
              const hasProto = !!e.data.prototype
              const hasLive = !!e.data.liveUrl
              const cardShell = 'group relative block aspect-[416/520] w-full overflow-hidden rounded-card stroke-gradient [--stroke-fill:var(--gradient-card)] transition duration-500 hover:-translate-y-1'
              const imgClass = 'h-full w-full object-cover grayscale transition duration-500 group-hover:scale-[1.02] group-hover:grayscale-0'
              // Primary action stretches over the whole card via inset-0.
              // The pill row sits above it (z-10) so both remain clickable.
              return (
                <Reveal>
                  <div class={cardShell}>
                    <img src={e.data.cover} alt={e.data.coverAlt} class={imgClass} />
                    {hasProto ? (
                      <button
                        type="button"
                        aria-label={t.exploration.openPrototype(e.data.title)}
                        class="absolute inset-0 z-0 cursor-pointer"
                        data-proto-src={embedSrc(e.data.prototype!)}
                        data-proto-title={e.data.prototypeTitle ?? e.data.title}
                      />
                    ) : (
                      <a
                        href={`/explorations/${e.data.slug}`}
                        aria-label={t.exploration.openDetails(e.data.title)}
                        class="absolute inset-0 z-0"
                      />
                    )}
                    {/* pointer-events-none lets clicks between/on the "See
                        Details" pill fall through to the stretched primary
                        action below. The live-site link re-enables pointer
                        events on itself so it captures its own clicks. */}
                    {/* Grid gives both pills equal columns cleanly — flex-1
                        wasn't equalising the mixed span/anchor children
                        reliably across browsers. */}
                    <div class:list={[
                      'pointer-events-none absolute inset-x-4 bottom-4 z-10 grid gap-3',
                      hasLive ? 'grid-cols-1 lg:grid-cols-2' : 'grid-cols-1',
                    ]}>
                      <Pill class="w-full justify-center">{t.exploration.seePrototype}</Pill>
                      {hasLive && (
                        <a
                          href={e.data.liveUrl!}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="pointer-events-auto min-w-0"
                        >
                          <Pill class="w-full justify-center">{t.exploration.visitLiveSite}</Pill>
                        </a>
                      )}
                    </div>
                  </div>
                </Reveal>
              )
            })}
          </div>
        ))}
      </div>
    )}
  </Container>

  {/* Fixed inset 0 forces the native <dialog> to stretch across the viewport;
      the inner box is centered via mx-auto + margin-top on the flex column.
      Some resets kill the UA-default `margin: auto` centering on dialog. */}
  <dialog
    id="exploration-prototype-modal"
    class="fixed inset-0 m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 text-text-primary backdrop:bg-black/70 backdrop:backdrop-blur-sm"
  >
    <div class="flex h-full w-full items-center justify-center p-4 md:p-8">
      <div data-proto-inner class="flex h-full w-full max-w-[1400px] flex-col overflow-hidden rounded-card border border-border bg-[#0B0B0B]">
        <div class="flex items-center justify-between gap-4 border-b border-border px-4 py-3">
          <div class="flex min-w-0 items-center gap-2">
            <span class="font-mono text-xs uppercase tracking-widest text-text-tertiary">{t.figmaEmbed.prototypeLabel}</span>
            <span data-proto-modal-title class="truncate font-mono text-sm text-text-primary"></span>
          </div>
          <button
            type="button"
            data-proto-modal-close
            aria-label={t.exploration.closePrototype}
            class="shrink-0 font-mono text-xs uppercase tracking-widest text-text-tertiary transition hover:text-text-primary"
          >{t.exploration.closeLabel}</button>
        </div>
        <iframe
          data-proto-modal-iframe
          title=""
          loading="lazy"
          allowfullscreen
          class="block w-full flex-1 border-0"
        ></iframe>
      </div>
    </div>
  </dialog>

  <script define:vars={{ fallbackTitle: t.figmaEmbed.prototypeLabel }}>
    const dialog = document.getElementById('exploration-prototype-modal') as HTMLDialogElement | null
    if (dialog) {
      const iframe = dialog.querySelector<HTMLIFrameElement>('[data-proto-modal-iframe]')!
      const titleEl = dialog.querySelector<HTMLElement>('[data-proto-modal-title]')!
      const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-proto-modal-close]')!

      document.querySelectorAll<HTMLButtonElement>('button[data-proto-src]').forEach(btn => {
        btn.addEventListener('click', () => {
          const src = btn.dataset.protoSrc ?? ''
          const title = btn.dataset.protoTitle ?? fallbackTitle
          iframe.src = src
          iframe.title = title
          titleEl.textContent = title
          dialog.showModal()
        })
      })

      // Clear the iframe on close so the Figma player stops running in the background.
      const clear = () => { iframe.src = 'about:blank' }
      closeBtn.addEventListener('click', () => dialog.close())
      dialog.addEventListener('close', clear)
      // Clicking the backdrop closes; native <dialog> reports the click on the dialog itself.
      // Any click that isn't inside the inner box counts as a backdrop click.
      dialog.addEventListener('click', ev => {
        const t = ev.target as HTMLElement
        if (!t.closest('[data-proto-inner]')) dialog.close()
      })
    }
  </script>
</section>
