---
/* Tab bar — Figma Draft: desktop `8:156`, mobile `8:662`.
   Navigation, not content switching (page spec): every section stays on the
   page, a tab scrolls to its section, and the active tab follows the section
   in view. The bar sticks under the compact header (mobile 80, desktop 84),
   and the compact header slides in when the bar reaches it.

   Icons are the Figma SVGs used as CSS masks, so the active (white) and
   inactive (#6C6C71) colours can swap without editing the files. The masks
   keep each path's alpha, including the 0.2-opacity duotone fill.

   The active underline is an inset box-shadow, not a border: Figma's 2px
   stroke sits inside the tab and does not move its content.

   Also the case study tab bar (Ficho: same concept as the home page): pass
   `items` (one per part, a `num` instead of an icon) and `label`. There the
   header is always shown, so the script only marks the bar stuck. Desktop tabs
   are at least 66.4 tall (the height the 26.4px Exploration icon gives the home
   bar), so a bar without icons is the same 68.4 and --sticky-offset holds. */
import { resolveLocale, useTranslations } from '../../i18n/ui'

interface Item { id: string; label: string; icon?: string; large?: boolean; num?: string }
interface Props { items?: Item[]; label?: string }

const lang = resolveLocale(Astro.currentLocale)
const t = useTranslations(lang)

// Targets are the current section ids; redesigned sections keep them.
const homeTabs: Item[] = [
  { id: 'experience', label: t.tabs.experience, icon: '/images/icons/tab-experience.svg', large: false },
  { id: 'skills', label: t.tabs.skills, icon: '/images/icons/tab-skills.svg', large: false },
  { id: 'work', label: t.tabs.studyCase, icon: '/images/icons/tab-study-case.svg', large: false },
  { id: 'explorations', label: t.tabs.exploration, icon: '/images/icons/tab-exploration.svg', large: true },
]
const { items = homeTabs, label = t.tabs.label } = Astro.props
const tabs = items
---
<nav
  aria-label={label}
  class="sticky top-[80px] z-40 transition-colors duration-300 data-stuck:bg-neutral-900/88 data-stuck:backdrop-blur-lg desktop:top-[84px] before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-neutral-800 after:absolute after:inset-x-0 after:bottom-0 after:h-px after:bg-neutral-800 desktop:border-y desktop:border-neutral-800 desktop:before:hidden desktop:after:hidden"
  data-figma="tab-bar"
  data-tab-bar
>
  {/* Mobile: Figma's 1px top/bottom strokes do not take layout space (the
      56px tabs fill the 56px frame), so they are pseudo-element lines under
      the tabs. Desktop: the strokes are in layout (1 + 66.4 + 1). */}
  <div class="mx-auto w-full max-w-[1088px] desktop:px-(--space-24)">
    <ul class="relative flex overflow-x-auto [scrollbar-width:none] desktop:overflow-visible [&::-webkit-scrollbar]:hidden" data-tab-scroller>
      {tabs.map((tab, i) => (
        <li class="flex shrink-0 desktop:min-w-0 desktop:flex-1">
          <a
            href={`#${tab.id}`}
            data-tab={tab.id}
            data-active={i === 0 ? '' : undefined}
            aria-current={i === 0 ? 'true' : undefined}
            class="group flex h-[56px] flex-1 items-center justify-center gap-(--space-6) whitespace-nowrap px-(--space-24) text-body-sm transition-colors duration-200 font-normal text-neutral-600 data-active:font-semibold data-active:text-neutral-100 data-active:shadow-[inset_0_-2px_0_var(--color-neutral-100)] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-neutral-100 desktop:h-auto desktop:min-h-[66.4px] desktop:gap-(--space-8) desktop:py-(--space-20) desktop:text-button-md desktop:font-semibold"
            data-figma={`tab-bar/${tab.id}`}
          >
            {/* Icon sizes: mobile 20 (Exploration 24), desktop 22 (Exploration 26.4).
                Case study parts show their number instead. */}
            {tab.num ? <span>{tab.num}</span> : (
            <span
              aria-hidden="true"
              class:list={[
                'shrink-0 bg-neutral-800 transition-colors duration-200 group-data-active:bg-neutral-100 [mask-position:center] [mask-repeat:no-repeat] [mask-size:contain]',
                tab.large ? 'size-6 desktop:size-[26.4px]' : 'size-5 desktop:size-[22px]',
              ]}
              style={`mask-image: url(${tab.icon}); -webkit-mask-image: url(${tab.icon});`}
            ></span>
            )}
            <span>{tab.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  /* Hover (not in Figma, Ficho): an inactive tab's label turns white and its
     icon lightens to #BBBBC0. The active tab is already white and stays put. */
  @media (hover: hover) {
    a[data-tab]:not([data-active]):hover { color: var(--color-neutral-100); }
    a[data-tab]:not([data-active]):hover > span[aria-hidden] { background-color: var(--color-neutral-600); }
  }
</style>

<script>
  // Scroll-spy: the active tab is the last section whose top has passed a
  // reading line — 30% down the viewport, or just under the tab bar if that
  // is lower. Sections land 128px from the top after a tab click
  // (scroll-mt-32), which is above that line. Before the first section the
  // first tab stays active, as in the Figma default frame.
  const bar = document.querySelector<HTMLElement>('[data-tab-bar]')
  // Home: the compact header that slides in. Case study: the always-on header.
  const compact = document.querySelector<HTMLElement>('[data-compact-header]')
  const header = compact ?? document.querySelector<HTMLElement>('[data-case-header]')
  const scroller = bar?.querySelector<HTMLElement>('[data-tab-scroller]')
  const links = Array.from(bar?.querySelectorAll<HTMLAnchorElement>('[data-tab]') ?? [])
  const sections = links
    .map((a) => document.getElementById(a.dataset.tab ?? ''))
    .filter((s): s is HTMLElement => s !== null)

  let current = links[0]?.dataset.tab
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

  function setActive(id: string | undefined) {
    if (!id || id === current) return
    current = id
    for (const a of links) {
      const on = a.dataset.tab === id
      a.toggleAttribute('data-active', on)
      if (on) a.setAttribute('aria-current', 'true')
      else a.removeAttribute('aria-current')
      // Mobile: keep the active tab visible inside the horizontal scroller
      // without scrolling the page itself.
      if (on && scroller && scroller.scrollWidth > scroller.clientWidth) {
        const left = a.offsetLeft - (scroller.clientWidth - a.offsetWidth) / 2
        scroller.scrollTo({ left, behavior: reduceMotion.matches ? 'auto' : 'smooth' })
      }
    }
  }

  // Compact header: shown once the bar is stuck under it (its top has reached
  // the header's height), hidden again while the hero is back in view.
  let shown = false
  function updateHeader() {
    if (!bar || !header) return
    const stuck = bar.getBoundingClientRect().top <= header.offsetHeight + 0.5
    if (stuck === shown) return
    shown = stuck
    // At rest the bar is see-through like the page (video under the page
    // scrim); once stuck it needs its own surface over the scrolling content.
    bar.toggleAttribute('data-stuck', stuck)
    if (!compact) return
    compact.toggleAttribute('data-shown', stuck)
    compact.setAttribute('aria-hidden', String(!stuck))
    compact.inert = !stuck
  }

  function update() {
    updateHeader()
    if (!bar || sections.length === 0) return
    const line = Math.max(bar.getBoundingClientRect().bottom + 24, window.innerHeight * 0.3)
    let id = sections[0].id
    for (const s of sections) if (s.getBoundingClientRect().top <= line) id = s.id
    setActive(id)
  }

  // update() reads four rects and only writes when the active tab changes,
  // so it runs straight from the (passive) scroll event.
  window.addEventListener('scroll', update, { passive: true })
  window.addEventListener('resize', update)
  update()
</script>
