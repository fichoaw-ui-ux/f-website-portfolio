---
/* Skills & Tools — Figma Draft: desktop `8:247`, mobile `8:753`.
   Chip lists follow the CV on every breakpoint (Ficho, 2026-11-07; UX Writing removed 2026-11-12): 9 skills,
   12 tools. Replaces the legacy About section; its bio and portrait now live
   in the hero.
   The section's 1px top stroke is in layout in both frames (content starts at
   88 + 1 desktop, 48 + 1 mobile), so it is a real border. */
import ContentBand from '../layout/ContentBand.astro'
import { getSite } from '../../content/site'
import { resolveLocale, useTranslations } from '../../i18n/ui'

const lang = resolveLocale(Astro.currentLocale)
const site = getSite(lang)
const t = useTranslations(lang)

const groups = [
  { key: 'skills', heading: t.skillsTools.skills, items: site.skills },
  { key: 'tools', heading: t.skillsTools.tools, items: site.tools },
]
---
<section
  id="skills"
  class="scroll-mt-(--sticky-offset) border-t border-neutral-800 py-(--space-48) desktop:py-(--space-88)"
  data-figma="skills-tools"
>
  <ContentBand class="flex flex-col gap-(--space-32) desktop:flex-row desktop:gap-(--space-64)">
    {groups.map((g) => (
      <div class="flex min-w-0 flex-col gap-(--space-32) desktop:flex-1 desktop:gap-(--space-40)" data-figma={`skills-tools/${g.key}`}>
        {/* Headings: mobile 24/1.25 (Mobile/Display/Heading H3), desktop 32/1.25 (H1). */}
        <h2 class="text-mobile-h3 text-neutral-600 desktop:text-mobile-h1" data-motion="lines">{g.heading}</h2>
        {/* Chips: mobile px12 py4 (Ficho; Figma px8), 14/22 regular (32 tall);
            desktop px16 py12, 16/1 semibold (42 tall). Gaps 8 / 12. */}
        {/* Interaction (Ficho, 2026-11-12; not in Figma): chips rise one by one
            when they scroll into view (shared runtime, src/scripts/motion), and
            on desktop hover lift 2px with a faint white glow. Both are off
            under reduced motion. */}
        <ul class="flex flex-wrap gap-(--space-8) desktop:gap-(--space-12)" data-figma={`skills-tools/${g.key}/chips`}>
          {g.items.map((item) => (
            <li
              class="rounded-(--radius-pill) border border-neutral-800 px-(--space-12) py-(--space-4) text-body-sm whitespace-nowrap text-neutral-100 transition-[translate,box-shadow] duration-200 desktop:px-(--space-16) desktop:py-(--space-12) desktop:text-button-md motion-safe:desktop:hover:translate-y-[-2px] motion-safe:desktop:hover:shadow-[0_0_16px_rgba(255,255,255,0.08)]"
              data-chip
              data-motion="rise"
              data-motion-distance="sm"
            >{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </ContentBand>
</section>

