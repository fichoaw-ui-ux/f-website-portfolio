---
import Container from '../layout/Container.astro'
import Reveal from '../ui/Reveal.astro'
import { getSite } from '../../content/site'
import { resolveLocale, useTranslations } from '../../i18n/ui'

const lang = resolveLocale(Astro.currentLocale)
const site = getSite(lang)
const t = useTranslations(lang)

// **word** → highlighted span. Escape first so raw HTML in copy can't break out.
function escape(s: string) {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
}
function highlight(text: string) {
  return escape(text).replace(
    /\*\*([^*]+)\*\*/g,
    '<mark class="bg-transparent font-semibold text-inherit">$1</mark>',
  )
}
---
<section id="experience" class="py-section-y-sm md:py-section-y scroll-mt-32">
  <Container>
    <Reveal>
      <h2 class="font-display font-semibold text-display-lg text-text-primary">{t.experience.heading}</h2>
    </Reveal>

    <ul class="mt-16">
      {site.experience.map((e, i) => (
        <Reveal as="li" delay={i * 60} class={i > 0 ? 'mt-8 border-t border-border pt-8' : ''}>
          <div class="grid gap-4 md:grid-cols-[360px_1fr] md:gap-8">
            <div class="text-lg leading-[1.6] text-text-tertiary md:text-2xl">{e.year}</div>
            <div>
              <div class="flex flex-wrap items-baseline gap-3 text-lg leading-[1.6] text-text-primary md:text-2xl">
                <span>{e.company}</span>
                {/* Hidden from assistive tech: read aloud it turns
                    "Transfez & Jack, Product Designer" into
                    "Transfez and Jack hyphen Product Designer". */}
                <span class="text-text-tertiary" aria-hidden="true">-</span>
                <span>{e.role}</span>
              </div>
              <ul class="mt-3 space-y-5">
                {e.sections.map(s => (
                  <li>
                    {s.label ? (
                      <>
                        <div class="flex gap-2 text-lg leading-[1.6] text-text-primary md:text-xl">
                          {/* Bigger glyph than the sub-items, decoration only. */}
                          <span class="select-none text-[1.4em] leading-[1.1]" aria-hidden="true">&bull;</span>
                          <span class="font-medium">{s.label}</span>
                        </div>
                        <ul class="mt-2 space-y-2 pl-7">
                          {s.items.map(h => (
                            <li class="flex gap-2 text-lg leading-[1.6] text-text-secondary">
                              <span class="select-none text-[1.2em] leading-[1.1]" aria-hidden="true">&bull;</span>
                              <span set:html={highlight(h)} />
                            </li>
                          ))}
                        </ul>
                      </>
                    ) : (
                      <ul class="space-y-2">
                        {s.items.map(h => (
                          <li class="flex gap-2 text-lg leading-[1.6] text-text-secondary">
                            <span class="select-none text-[1.2em] leading-[1.1]" aria-hidden="true">&bull;</span>
                            <span set:html={highlight(h)} />
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </Reveal>
      ))}
    </ul>
  </Container>
</section>
