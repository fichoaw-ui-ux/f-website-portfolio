---
import { getCollection } from 'astro:content'
import Container from '../layout/Container.astro'
import Reveal from '../ui/Reveal.astro'
import { sortByOrder, filterFeatured, localeEntries } from '../../lib/content'
import { resolveLocale, useTranslations } from '../../i18n/ui'
import { getRelativeLocaleUrl } from 'astro:i18n'

const lang = resolveLocale(Astro.currentLocale)
const t = useTranslations(lang)
const all = await getCollection('case-studies')
const featured = sortByOrder(filterFeatured(localeEntries(all, lang)))
---
<section id="work" class="py-section-y-sm md:py-section-y scroll-mt-32">
  <Container>
    <Reveal>
      <div class="mx-auto max-w-[1088px] text-center">
        <h2 class="font-display font-semibold text-display-lg text-text-primary">{t.selectedWork.heading}</h2>
      </div>
    </Reveal>

    {featured.length === 0 && <p class="mt-16 text-text-tertiary">{t.selectedWork.noProjects}</p>}

    {/* Sticky stacking. All slots end at the SAME absolute y, so every card
        un-sticks together and the whole stack scrolls into the next section
        as one — instead of the earliest card releasing first and peeling off
        the top.

        Naïve pattern (all cards as siblings of one tall parent) breaks in
        Chrome: sticky-N's shift is bounded by its next flow sibling, so
        card N un-sticks the moment card N+1 approaches. Per-slot runways
        fix that, but naïve equal-height slots (each 200vh, overlapping
        100vh) end at different y's — slot 0 ends at 200vh, slot 1 at 300vh,
        so card 0 peels off at 200vh while card 1 stays pinned.

        Fix: stretch every earlier slot's runway down to the final slot's
        bottom. For N cards each contributing 100vh of scroll, the container
        is H = N * 100vh tall — just enough for the last card to climb into
        place, with the release landing on the very next tick. A bigger H
        (e.g. (N+1)*100vh) would tack on extra empty runway after stacking
        is done, which reads as "why am I still scrolling here?". Slot i
        starts at i * 100vh from the container top and ends at H. In flow
        terms: slot 0 gets height H, slot i (i>0) gets height H - i*100vh
        and a negative margin-top of (i*100vh - H) to pull it back so it
        starts at i*100vh. All slots' bottoms land on H → every sticky
        card releases at the same instant.

        Named view-timelines per slot let card i shrink while slot (i+1) is
        in its "contain" phase (i.e. filling the scrollport), which is the
        exact window during which card (i+1) climbs into position over
        card i. `timeline-scope` on the wrapper hoists the names so an
        earlier card can reference a later slot's timeline. */}
    <div
      class="mt-16"
      style={`timeline-scope: ${featured.map((_, i) => `--stack-${i}`).join(', ')};`}
    >
      {featured.map((p, i) => {
        const N = featured.length
        const H = N * 100
        const slotHeight = H - i * 100
        const marginTop = i === 0 ? 0 : i * 100 - H
        const nextTimeline = i < N - 1 ? `--stack-${i + 1}` : null
        const slotStyle = [
          `min-height: ${slotHeight}vh`,
          i > 0 ? `margin-top: ${marginTop}vh` : null,
          `view-timeline-name: --stack-${i}`,
        ].filter(Boolean).join('; ')
        const cardStyle = [
          `top: calc(168px + ${i} * 16px)`,
          nextTimeline ? `animation-timeline: ${nextTimeline}` : null,
        ].filter(Boolean).join('; ')
        return (
        <div class="stack-slot relative" style={slotStyle}>
        <div
          class="stack-card sticky w-full origin-top will-change-transform"
          style={cardStyle}
        >
          <a
            href={getRelativeLocaleUrl(lang, `/work/${p.data.slug}`)}
            class="group block rounded-[32px] stroke-gradient [--stroke-fill:var(--gradient-card)] p-6 transition duration-500 hover:-translate-y-1 md:p-12"
          >
            {/* 36% is Figma's 438px text column over the 1216px inner width of
                a 1312px card, so it resolves to 438px at 1440. A fixed 438px
                squeezed the thumbnail to 122px at 768 — hence proportional,
                and hence lg rather than md. */}
            <div class="grid items-center gap-8 lg:grid-cols-[36%_1fr] lg:items-stretch lg:gap-12">
              <div class="order-2 lg:order-1 lg:flex lg:h-full lg:flex-col lg:items-start lg:justify-center">
                <span class="block text-display-md leading-none" aria-hidden="true">{p.data.icon}</span>
                <h3 class="mt-4 font-display font-semibold text-display-md text-text-primary">{p.data.title}</h3>
                {/* leading-tight, not leading-none. Figma's tag line is a
                    single 16px row, but three tags wrap below about 1024 —
                    at 375 the text is ~323px in a 279px column — and
                    leading-none makes the wrapped lines touch. */}
                <p class="mt-4 text-base font-semibold uppercase leading-tight text-text-tertiary">
                  {p.data.tags.join(', ')}
                </p>
                <p class="mt-6 text-base leading-[1.6] text-text-tertiary md:mt-8 md:text-lg">{p.data.summary}</p>
                <span
                  class="mt-8 inline-flex h-12 items-center gap-2 rounded-full stroke-gradient [--stroke-fill:var(--gradient-card)] px-5 text-base font-semibold leading-none text-text-primary transition duration-300 group-hover:[--stroke-fill:linear-gradient(var(--color-bg-elevated),var(--color-bg-elevated))]"
                >
                  <span>{t.common.viewDetails}</span>
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14" />
                    <path d="m13 5 7 7-7 7" />
                  </svg>
                </span>
              </div>
              <div class="order-1 aspect-[730/438] overflow-hidden rounded-media bg-bg-primary lg:order-2 lg:aspect-auto lg:h-full">
                <img
                  src={p.data.thumbnail}
                  alt={p.data.thumbnailAlt}
                  class="h-full w-full object-cover grayscale transition duration-500 group-hover:scale-[1.02] group-hover:grayscale-0"
                />
              </div>
            </div>
          </a>
        </div>
        </div>
        )
      })}
    </div>
  </Container>
</section>

<style>
  /* Kartu lama menyusut ke belakang selama kartu berikutnya sedang memanjat.
     Setiap kartu i (kecuali yang terakhir) diikat ke view-timeline slot
     berikutnya (slot i+1) lewat style inline. Fase yang dipakai adalah
     "entry" — jendela ketika tepi atas slot i+1 mulai muncul di dasar
     viewport hingga menyentuh puncak viewport, yaitu persis saat kartu
     i+1 naik dari bawah dan tiba di posisi pin-nya. Setelah itu (fase
     contain), kartu i sudah dalam bentuk mengecilnya dan tetap begitu
     berkat animation-fill-mode: both. Kartu terakhir tidak punya
     penerus, jadi animasinya dimatikan. */
  .stack-slot { view-timeline-axis: block; }

  /* Sticky stacking is a large-viewport effect. Below md the runway inflates to
     ~300vh of empty scroll and the shrink-into-the-next-card motion reads as
     disorientation on a phone, so collapse every slot to its card's natural
     height and let cards flow like a normal list. Gap comes back via margin. */
  @media (max-width: 767px) {
    .stack-slot {
      min-height: 0 !important;
      margin-top: 0 !important;
    }
    .stack-slot + .stack-slot { margin-top: 2rem !important; }
    .stack-card {
      position: static !important;
      top: auto !important;
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }

  @supports (animation-timeline: view()) {
    .stack-card {
      animation-name: stack-shrink;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-range: entry 0% entry 100%;
    }
    .stack-slot:last-child .stack-card { animation: none; }
    @keyframes stack-shrink {
      to { transform: scale(0.92); opacity: 0.6; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-card { animation: none !important; }
  }
</style>
