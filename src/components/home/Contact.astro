---
import Container from '../layout/Container.astro'
import Reveal from '../ui/Reveal.astro'
import Button from '../ui/Button.astro'
import { site } from '../../content/site'

const linkedin = site.socials.find(s => s.label === 'LinkedIn')
const whatsapp = site.socials.find(s => s.label === 'WhatsApp')
---
{/* 818px is Figma's 880px section minus the 62px footer strip that follows. */}
<section id="contact" class="flex min-h-[480px] items-center py-16 scroll-mt-32 md:min-h-[818px] md:py-24">
  <Container>
    <Reveal>
      <div class="mx-auto max-w-[1088px] text-center">
        <h2 class="font-display font-semibold text-display-lg text-text-primary">
          Let's build something together
        </h2>

        <p class="mx-auto mt-6 max-w-[640px] text-lg leading-[1.6] text-text-secondary md:mt-8 md:text-2xl">
          Open to product design work and collaborations. You can reach me at{' '}
          <a
            href={`mailto:${site.email}`}
            class="font-medium text-text-primary underline decoration-border underline-offset-4 transition hover:decoration-text-primary"
          >{site.email}</a>, or say hi on LinkedIn or WhatsApp below.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          {linkedin && <Button href={linkedin.href} variant="ghost">LinkedIn</Button>}
          {whatsapp && <Button href={whatsapp.href} variant="ghost">WhatsApp</Button>}
        </div>
      </div>
    </Reveal>
  </Container>
</section>
