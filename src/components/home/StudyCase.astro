---
/* Study Case — Figma Draft: desktop `8:290`, mobile `8:798`.
   Content comes from the featured case studies (2 today; Figma's 3rd card is
   a duplicate placeholder). Figma's covers are placeholders, so the real
   thumbnails fill the same boxes. Tags: everything except "Product Design"
   (Ficho: show industry/platform, as the design does).
   Replaces the legacy SelectedWork sticky-stack; the design is a plain list.
   Covers are black & white and turn to colour (with a 1.02 zoom) while the
   card is hovered — kept from the previous design (Ficho), not in Figma.

   Desktop: rows (cover 504×360 | content), 1px dividers, content centred.
   Mobile: bordered cards (stroke inside the 24px padding, so p = 23 + 1),
   title before tags, Figma's drop shadow on the card. */
import { getCollection } from 'astro:content'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { Image } from 'astro:assets'
import ContentBand from '../layout/ContentBand.astro'
import { sortByOrder, filterFeatured, localeEntries } from '../../lib/content'
import { resolveLocale, useTranslations } from '../../i18n/ui'

const lang = resolveLocale(Astro.currentLocale)
const t = useTranslations(lang)
const all = await getCollection('case-studies')
const featured = sortByOrder(filterFeatured(localeEntries(all, lang)))
const HIDDEN_TAGS = new Set(['Product Design'])
---
<section
  id="work"
  class="scroll-mt-(--sticky-offset) border-t border-neutral-800 py-(--space-48) desktop:py-(--space-88)"
  data-figma="study-case"
>
  <ContentBand>
    <h2 class="text-mobile-h3 text-neutral-600 desktop:text-mobile-h1">{t.selectedWork.heading}</h2>

    {featured.length === 0 && <p class="mt-(--space-32) text-body-sm text-neutral-600">{t.selectedWork.noProjects}</p>}

    <ul class="mt-(--space-32) flex flex-col gap-(--space-32) desktop:mt-(--space-40) desktop:gap-0" data-figma="study-case/list">
      {featured.map((p, i) => {
        const href = getRelativeLocaleUrl(lang, `/work/${p.data.slug}`)
        const tags = p.data.tags.filter((tag) => !HIDDEN_TAGS.has(tag))
        return (
          <li class:list={[i > 0 && 'desktop:mt-(--space-40) desktop:border-t desktop:border-neutral-800 desktop:pt-(--space-40)']}>
            {/* Desktop divider: 40 + 1px + 40 between rows, as in Figma. */}
            <article
              class="group flex flex-col gap-(--space-24) rounded-(--radius-container) border border-neutral-800 p-[23px] [filter:drop-shadow(0_4px_6px_rgba(22,34,51,0.12))_drop-shadow(0_16px_16px_rgba(22,34,51,0.16))] desktop:flex-row desktop:items-center desktop:gap-(--space-32) desktop:rounded-none desktop:border-0 desktop:p-0 desktop:[filter:none]"
              data-figma={`study-case/${p.data.slug}`}
            >
              {/* Cover: mobile 200 tall, 2px #BBBBC0 stroke; desktop 504×360, no stroke.
                  Also a link to the study (Ficho): a mouse/touch shortcut beside View
                  Details, so it is out of the tab order and hidden from screen readers
                  (the button is the one accessible link). Hovering it lights the button. */}
              <a
                href={href}
                tabindex="-1"
                aria-hidden="true"
                data-cover-link
                class="block h-[200px] shrink-0 overflow-hidden rounded-(--radius-container) border-2 border-neutral-600 bg-neutral-200 desktop:h-[360px] desktop:min-w-0 desktop:flex-1 desktop:border-0"
                data-figma={`study-case/${p.data.slug}/cover`}
              >
                {/* Rendered 302 wide on mobile (306 box − 2px stroke), 504 on desktop; 1× and 2×. */}
                <Image
                  src={p.data.thumbnail}
                  alt={p.data.thumbnailAlt}
                  widths={[302, 504, 604, 1008]}
                  sizes="(min-width: 1024px) 504px, 302px"
                  loading="lazy"
                  class="size-full object-cover grayscale transition duration-500 group-hover:scale-[1.02] group-hover:grayscale-0"
                />
              </a>

              <div class="flex min-w-0 flex-col items-start desktop:flex-1" data-figma={`study-case/${p.data.slug}/content`}>
                {/* Order and gaps differ: mobile title → 12 → tags → 12 → summary → 32 → button;
                    desktop tags → 16 → title → 8 → summary → 24 → button (title → summary
                    8 and summary → button 24 instead of Figma's 16 / 16, Ficho). */}
                <h3 class="order-1 w-full text-title-md text-neutral-100 desktop:order-2 desktop:mt-(--space-16) desktop:text-title-lg">{p.data.title}</h3>
                <ul class="order-2 mt-(--space-12) flex flex-wrap gap-(--space-8) desktop:order-1 desktop:mt-0" aria-label="Tags">
                  {tags.map((tag) => (
                    <li class="rounded-(--radius-pill) border border-neutral-800 px-(--space-8) py-(--space-4) text-button-sm text-neutral-600 desktop:px-(--space-10)">
                      {/* mobile 14/1 semibold = Button/Small (Figma 12, raised by Ficho) */}
                      {tag}
                    </li>
                  ))}
                </ul>
                {/* Desktop summary: Figma 16/26, raised to 18/29 (Ficho, +2px; not in tokens).
                    Tags (labels) and the View Details button keep Figma's sizes. */}
                <p class="order-3 mt-(--space-12) w-full text-body-sm text-neutral-100 desktop:mt-(--space-8) desktop:text-[18px] desktop:leading-[29px]">{p.data.summary}</p>
                {/* Mobile button: Figma has a 1px stroke the same colour as the fill,
                    inside the 36px height — invisible, so it is left out. */}
                <a
                  href={href}
                  class="group/button order-4 mt-(--space-32) inline-flex items-center gap-(--space-4) rounded-(--radius-pill) bg-neutral-800 px-(--space-12) py-(--space-12) text-button-sm text-neutral-100 transition-[filter] duration-200 hover:brightness-110 group-has-[[data-cover-link]:hover]:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-100 desktop:mt-(--space-24) desktop:gap-(--space-8) desktop:px-(--space-20) desktop:py-(--space-12) desktop:text-button-md"
                  data-figma={`study-case/${p.data.slug}/button`}
                >
                  {t.common.viewDetails}<span class="sr-only">: {p.data.title}</span>
                  <img src="/images/icons/arrow-forward.svg" alt="" width="20" height="20" class="size-5 transition-transform duration-200 group-hover/button:translate-x-1 group-has-[[data-cover-link]:hover]:translate-x-1" />
                </a>
              </div>
            </article>
          </li>
        )
      })}
    </ul>
  </ContentBand>
</section>
