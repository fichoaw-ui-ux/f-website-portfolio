---
import Container from '../layout/Container.astro'
import Pill from '../ui/Pill.astro'
import Reveal from '../ui/Reveal.astro'
import { getSite } from '../../content/site'
import { resolveLocale, useTranslations } from '../../i18n/ui'

const lang = resolveLocale(Astro.currentLocale)
const site = getSite(lang)
const t = useTranslations(lang)
---
<section id="about" class="overflow-x-clip py-section-y-sm md:py-section-y scroll-mt-32">
  <Container>
    {/* Proportional columns, not Figma's literal 620px. A fixed 620px column
        needs a ~1312px content band to leave room for the portrait; at 768 it
        pushed the portrait off-screen, hidden only by overflow-x-clip. 47.3%
        is 620/1312, so it resolves to Figma's width at 1440 and degrades
        instead of overflowing below that. Two columns start at lg, not md,
        for the same reason. */}
    <div class="grid items-start gap-12 lg:grid-cols-[47.3%_1fr] lg:items-stretch lg:gap-20">
      {/* From lg up the portrait is absolutely positioned inside its grid cell
          so it does not contribute to the row's intrinsic height — the row is
          driven by the text column, `items-stretch` stretches the (empty)
          image cell to match, and `inset-0` fills it. The -18px left bleed
          survives via `left`. Below lg it falls back to its natural 646/861
          aspect since the columns stack and there is no row height to
          inherit. `overflow-x-clip` on the section guards the bleed against a
          horizontal scrollbar at intermediate widths. */}
      <Reveal delay={100} class="order-1 lg:relative lg:order-2 lg:h-full">
        <img
          src="/images/ficho-portrait.png"
          alt={t.about.portraitAlt(site.name)}
          class="mx-auto aspect-[646/861] w-full max-w-[480px] rounded-card object-cover grayscale transition duration-500 hover:grayscale-0 lg:absolute lg:inset-y-0 lg:left-[-18px] lg:right-auto lg:mx-0 lg:aspect-auto lg:h-full lg:w-[calc(100%+18px)] lg:max-w-none"
        />
      </Reveal>

      <Reveal class="order-2 lg:order-1">
        <div>
          <h2 class="font-display font-semibold text-display-lg text-text-primary">{t.about.heading}</h2>
          <div class="mt-6 max-w-[559px] space-y-4 text-[20px] leading-[1.6] text-text-secondary">
            {site.bio.map(paragraph => <p>{paragraph}</p>)}
          </div>

          <hr class="my-8 border-0 border-t border-border" />

          <div>
            <div class="text-lg leading-[1.6] text-text-tertiary">{t.about.skills}</div>
            <div class="mt-4 flex flex-wrap gap-4">{site.skills.map(s => <Pill>{s}</Pill>)}</div>
          </div>

          <hr class="my-8 border-0 border-t border-border" />

          <div>
            <div class="text-lg leading-[1.6] text-text-tertiary">{t.about.tools}</div>
            <div class="mt-4 flex flex-wrap gap-4">{site.tools.map(tool => <Pill>{tool}</Pill>)}</div>
          </div>
        </div>
      </Reveal>
    </div>
  </Container>
</section>
