---
/* Compact header — Figma Draft: desktop `25:1716` (scrolled frame 25:1506),
   mobile `25:2226` (scrolled frame 25:2011).
   Fixed at the top, hidden while the hero is on screen; it slides/fades in
   when the tab bar reaches it (page spec), and the tab bar sticks right under
   it (TabBar.astro). Desktop 79 tall (16 + 51 text column + 12), mobile 64 (8 + 48 + 8):
   the photo is 48 and the name 16 at both sizes (Ficho; Figma 56 / 64, 20 / 18).
   Right side: language switch + Contact pill (desktop, gap 16; 44 tall) or
   language switch + a 24px contact icon (mobile, gap 12). Figma's mobile icon
   is a menu glyph; Ficho meant a contact icon — the envelope from the Contact
   section, in white like Figma's glyph, linking to #contact.

   Figma sets the desktop name/handle in Inter; rendered in Aileron, the handle
   at Figma's 15/23 (22.5 rounded as Figma renders it). The photo's #252525 stroke matches
   the #252525 background, so it is invisible and left out. */
import { Image } from 'astro:assets'
import ContentBand from '../layout/ContentBand.astro'
import HeaderActions from '../layout/HeaderActions.astro'
import portrait from '../../assets/hero/portrait.png'
import { getSite } from '../../content/site'
import { resolveLocale, useTranslations } from '../../i18n/ui'

const lang = resolveLocale(Astro.currentLocale)
const site = getSite(lang)
const t = useTranslations(lang)
---
<div
  class="fixed inset-x-0 top-0 z-50 mx-auto max-w-[402px] -translate-y-full bg-neutral-900/88 opacity-0 backdrop-blur-lg transition-[translate,opacity] duration-300 ease-out data-shown:translate-y-0 data-shown:opacity-100 desktop:max-w-none"
  data-compact-header
  data-figma="compact-header"
  aria-hidden="true"
  inert
>
  {/* max-w 402 below the desktop breakpoint follows the 402px mobile artboard lock (global.css). */}
  <ContentBand class="flex items-center gap-(--space-16) py-(--space-8) desktop:pt-(--space-16) desktop:pb-(--space-12)">
    {/* Photo 48 (Ficho). Figma's crop scaled to 48: mobile image 48×64, +4.125
        (from 64×85, +5.5); desktop 48×64, +0.12 (from 56.07×74.76, +0.14). */}
    <div class="relative size-(--space-48) shrink-0 overflow-hidden rounded-(--radius-container)">
      {/* container radius (Ficho; Figma 16 / 6.72) */}
      <Image
        src={portrait}
        alt=""
        widths={[48, 96]}
        sizes="48px"
        class="absolute left-1/2 top-[calc(50%+4.125px)] h-[64px] w-(--space-48) max-w-none -translate-x-1/2 -translate-y-1/2 object-cover desktop:top-[calc(50%+0.12px)]"
      />
    </div>

    <div class="flex min-w-0 flex-1 flex-col gap-(--space-4) whitespace-nowrap desktop:gap-(--space-2)">
      {/* "Ficho Aji W" as designed (Ficho), 16 at both sizes (Ficho). Desktop handle 15/23: not in tokens (Figma Inter, 150%). */}
      <p class="text-title-xmd text-neutral-100">Ficho Aji W</p>
      <p class="text-button-sm text-neutral-600 desktop:text-[15px] desktop:leading-[23px] desktop:font-normal">{site.handle}</p>
    </div>

    <HeaderActions place="compact-header" />
  </ContentBand>
</div>
