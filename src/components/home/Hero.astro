---
/* Hero — Figma Draft: desktop `8:117`, mobile `8:627` (+ top band `8:625`).
   Value sheet and assumptions: docs/design/page-spec.md → Hero.
   Mobile and desktop order the content differently (mobile: name → bio →
   meta → divider → socials; desktop: identity column | bio column), so the
   identity wrapper is `display: contents` on mobile and its children are
   ordered into the single column with `order`. */
import { Image } from 'astro:assets'
import ContentBand from '../layout/ContentBand.astro'
import HeaderActions from '../layout/HeaderActions.astro'
import portrait from '../../assets/hero/portrait.png'
import { getSite } from '../../content/site'
import { resolveLocale } from '../../i18n/ui'

const lang = resolveLocale(Astro.currentLocale)
const site = getSite(lang)

// Figma order: WhatsApp, LinkedIn, Email.
const socialIcons: Record<string, string> = {
  WhatsApp: '/images/icons/whatsapp.svg',
  LinkedIn: '/images/icons/linkedin.svg',
  Email: '/images/icons/envelope.svg',
}
const socials = ['WhatsApp', 'LinkedIn', 'Email']
  .map((label) => site.socials.find((s) => s.label === label))
  .filter((s): s is (typeof site.socials)[number] => Boolean(s))
---
<section
  class="relative pt-(--space-24) pb-[55px] desktop:pt-(--space-64) desktop:pb-(--space-88)"
  data-figma="hero"
>
  {/* ASSUMED mobile: Figma's band is 128 tall but its top 56 is the iPhone
      status bar, so the web band is 72 and the photo sits 24 from the top.
      pb 55 = frame padding 24 + 31 free space before the tab bar (ASSUMED). */}
  <div class="absolute inset-x-0 top-0 h-[72px] bg-neutral-100 desktop:h-[164px]" data-figma="hero/top-band" aria-hidden="true"></div>

  <ContentBand class="relative">
    {/* Mobile: photo and language switch share a row (space-between, centred:
       Figma 25:1756). Desktop: the switch is absolutely placed at the content's
       right edge, 142 from the hero top (= 78 into the band, which starts at
       the 64px top padding) — Figma 25:1273, straddling the white band's edge. */}
    <div class="flex items-center justify-between gap-(--space-20)" data-figma="hero/avatar-row">
    {/* Photo: mobile 97×96 (image 96×128, nudged +0.5 / +6);
        desktop 200×200 r24 (image 200×267, nudged 0 / +0.5). */}
    <div
      class="relative h-[96px] w-[97px] overflow-hidden rounded-(--radius-container) border-2 border-border-strong desktop:size-[200px]"
      data-figma="hero/avatar"
    >
      {/* container radius on every breakpoint (Ficho; Figma 16 / 24) */}
      <Image
        src={portrait}
        alt=""
        widths={[96, 192, 200, 400]}
        sizes="(min-width: 1024px) 200px, 96px"
        loading="eager"
        class="absolute left-[calc(50%+0.5px)] top-[calc(50%+6px)] h-[128px] w-[96px] max-w-none -translate-x-1/2 -translate-y-1/2 object-cover desktop:left-1/2 desktop:top-[calc(50%+0.5px)] desktop:h-[267px] desktop:w-[200px]"
      />
    </div>
    {/* Language switch + Contact (Ficho), right-aligned like the compact header. */}
    <HeaderActions place="hero" boxedIcon class="desktop:absolute desktop:top-[78px] desktop:right-(--space-24)" />
    </div>

    {/* Avatar → content: mobile 20 (frame gap); desktop 60 = Profile pt 160 − 100px overlap. */}
    <div class="mt-(--space-20) flex flex-col desktop:mt-[60px] desktop:flex-row desktop:items-start desktop:gap-(--space-64)" data-figma="hero/profile-content">
      <div class="contents desktop:flex desktop:min-w-0 desktop:flex-1 desktop:flex-col" data-figma="hero/identity">
        <div class="flex flex-col desktop:gap-(--space-4)" data-figma="hero/name">
          <h1 class="text-title-xl text-neutral-100 desktop:text-[48px] desktop:leading-[1.25]" data-motion="letters" data-motion-trigger="load">
            {/* desktop 48/1.25: not in tokens — no text style in Figma */}
            {site.fullName}
          </h1>
          <p class="text-button-sm text-neutral-600 desktop:text-body-xl desktop:font-normal" data-motion="rise" data-motion-distance="sm" data-motion-trigger="load">{site.handle}</p>
        </div>

        <ul class="order-2 mt-(--space-24) flex items-center gap-(--space-22) desktop:order-none desktop:mt-(--space-20) desktop:gap-(--space-28)" data-figma="hero/meta">
          <li class="flex items-center gap-(--space-6) desktop:gap-(--space-8)" data-motion="rise" data-motion-distance="sm" data-motion-trigger="load">
            <img src="/images/icons/user.svg" alt="" width="20" height="20" class="size-4 desktop:size-5" />
            {/* mobile 14/1 semibold (Figma 12, raised by Ficho) = Button/Small */}
            <span class="text-button-sm text-neutral-600 desktop:text-button-md">{site.role}</span>
          </li>
          <li class="flex items-center gap-(--space-6) desktop:gap-(--space-8)" data-motion="rise" data-motion-distance="sm" data-motion-trigger="load">
            <img src="/images/icons/map-pin.svg" alt="" width="20" height="20" class="size-4 desktop:size-5" />
            <span class="text-button-sm text-neutral-600 desktop:text-button-md">{site.location}</span>
          </li>
        </ul>

        {/* Mobile: bio → 24 → meta → 24 → divider → 24 → socials (Ficho; Figma 16s,
            divider a 0-height vector). Here the divider is a real 1px line so both
            gaps around it are a full 24. Desktop is a 1px rect, 20 / 28 / 28. */}
        <div class="order-2 mt-(--space-24) h-px w-full bg-neutral-800 desktop:order-none desktop:mt-(--space-28)" data-figma="hero/divider"></div>

        {/* Social buttons: mobile 48 × 48, 20 icon centred (Ficho; Figma 38 = 8 + 20 + 8 + 2);
            desktop 58 (16 padding + 24 icon + border), as in Figma. */}
        <ul class="order-2 mt-(--space-24) flex items-center gap-(--space-8) desktop:order-none desktop:mt-(--space-28) desktop:gap-(--space-12)" data-figma="hero/socials">
          {socials.map((s) => (
            <li data-motion="rise" data-motion-distance="sm" data-motion-trigger="load">
              <a
                href={s.href}
                target={s.href.startsWith('http') ? '_blank' : undefined}
                rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                aria-label={s.label}
                class="flex size-(--space-48) items-center justify-center rounded-(--radius-container) border border-neutral-800 transition-colors duration-200 hover:border-neutral-600 hover:bg-neutral-100/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-100 desktop:size-auto desktop:p-(--space-16)"
                data-figma={`hero/socials/${s.label.toLowerCase()}`}
              >
                <img src={socialIcons[s.label]} alt="" width="24" height="24" class="size-5 desktop:size-6" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div
        class="order-1 mt-(--space-20) flex flex-col gap-(--space-12) text-body-sm text-neutral-100 desktop:order-none desktop:mt-0 desktop:min-w-0 desktop:flex-1 desktop:gap-(--space-20) desktop:text-body-xl"
        data-figma="hero/bio"
        data-motion="light-load"
        data-motion-delay="300"
      >
        {site.bio.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </ContentBand>
</section>
