---
/* Case study page — no Figma frame; styled from the redesigned home page
   (Ficho: "sesuaikan dengan halaman utamanya, sama persis"). Every value is a
   home-page token or a value already used there:
   - page: redesign surface (#252525 over the storm video), redesign footer;
   - header: the home compact header (CaseStudyHeader.astro);
   - column: ContentBand (1040 desktop, 24px gutters);
   - title block: tags as the Study Case tag pills, title in the Contact
     heading style (32 → 56) but white, summary in the Contact body style;
   - gaps: the home scale only — part 48 / 88 (section padding), part
     heading → content 32 / 40, sub-section 32 / 40 (Study Case rows), block
     (paragraph group, figure, quote, metrics) 24 / 32 (Experience jobs),
     title → text 12 / 16, paragraphs 16, list items 12, caption 12;
   - cover: Study Case cover, container radius (Ficho), B&W → colour on hover. */
import BaseLayout from './BaseLayout.astro'
import ContentBand from '../components/layout/ContentBand.astro'
import Reveal from '../components/ui/Reveal.astro'
import CaseStudyHeader from '../components/case-study/CaseStudyHeader.astro'
import NextProject from '../components/case-study/NextProject.astro'
import ProjectSnapshot from '../components/case-study/ProjectSnapshot.astro'
import Lightbox from '../components/case-study/Lightbox.astro'
import TabBar from '../components/home/TabBar.astro'
import { resolveLocale, useTranslations } from '../i18n/ui'
import type { CollectionEntry } from 'astro:content'
import { Image, getImage } from 'astro:assets'

interface Props {
  entry: CollectionEntry<'case-studies'>
  next: CollectionEntry<'case-studies'>
}
const { entry, next } = Astro.props
const d = entry.data

const lang = resolveLocale(Astro.currentLocale)
const t = useTranslations(lang)

// Same rule as the home Study Case list: industry/platform only (Ficho).
const HIDDEN_TAGS = new Set(['Product Design'])
const tags = d.tags.filter((tag) => !HIDDEN_TAGS.has(tag))

// Link previews want a modest JPEG at the classic 1200px width, not the
// 7680px source PNG.
const ogImage = await getImage({ src: d.cover, width: 1200, format: 'jpg' })

// Tab bar (Ficho: same concept as home): one tab per <PartHeader> in the MDX,
// linking to its `part-<n>` id.
const parts = [...(entry.body ?? '').matchAll(/<PartHeader\s+number="(\d+)"\s+title="([^"]+)"/g)]
  .map(([, num, title]) => {
    const n = String(parseInt(num, 10))
    return { id: `part-${n}`, num: `${n}.`, label: title }
  })
---
<BaseLayout title={`${d.title}${t.caseStudy.titleSuffix}`} description={d.summary} ogImage={ogImage.src} redesign showHeader={false}>
  <CaseStudyHeader />
  <article data-figma="case-study">
    {/* Reading layout like Notion (Ficho): everything sits in one centred
        720 column (the home Experience measure, not in tokens), the cover
        included (Ficho). Like the home page: intro (hero spacing 24 / 64 top,
        48 / 88 bottom), the sticky tab bar, then the parts with section
        padding 48 / 88. */}
    <ContentBand class="pt-(--space-24) pb-(--space-48) desktop:pt-(--space-64) desktop:pb-(--space-88)">
      <Reveal class="mx-auto max-w-[720px]">
        <header class="flex flex-col items-start" data-figma="case-study/title">
          <ul class="flex flex-wrap gap-(--space-8)" aria-label="Tags">
            {tags.map((tag) => (
              <li class="rounded-(--radius-pill) border border-neutral-800 px-(--space-8) py-(--space-4) text-button-sm text-neutral-600 desktop:px-(--space-10)">{tag}</li>
            ))}
          </ul>
          <h1 class="mt-(--space-16) text-mobile-h1 text-neutral-100 desktop:text-section-heading">{d.title}</h1>
          <p class="mt-(--space-16) text-mobile-subheading text-neutral-100 desktop:text-section-subheading">{d.summary}</p>
        </header>
      </Reveal>

      <Reveal delay={100} class="mx-auto max-w-[720px]">
        <div class="group mt-(--space-32) overflow-hidden rounded-(--radius-container) bg-neutral-200 desktop:mt-(--space-40)" data-figma="case-study/cover">
          {/* Column is at most 720 wide (354 on mobile); 1× and 2× sources. */}
          <Image
            src={d.cover}
            alt={d.coverAlt}
            widths={[354, 708, 720, 1440]}
            sizes="(min-width: 1024px) 720px, 354px"
            loading="eager"
            class="block h-auto w-full grayscale transition duration-500 group-hover:scale-[1.02] group-hover:grayscale-0"
          />
        </div>
      </Reveal>

    </ContentBand>

    {parts.length > 0 && <TabBar items={parts} label={t.caseStudy.partsLabel} />}

    <ContentBand class="py-(--space-48) desktop:py-(--space-88)">
      <div class="mx-auto max-w-[720px]" data-figma="case-study/body">
        {d.snapshot && d.snapshot.length > 0 && <ProjectSnapshot items={d.snapshot} />}

        <slot />
      </div>
    </ContentBand>
  </article>
  <NextProject slug={next.data.slug} title={next.data.title} summary={next.data.summary} tags={next.data.tags.filter((tag) => !HIDDEN_TAGS.has(tag))} cover={next.data.thumbnail} coverAlt={next.data.thumbnailAlt} />
  <Lightbox />
</BaseLayout>
