---
import BaseLayout from './BaseLayout.astro'
import Container from '../components/layout/Container.astro'
import Reveal from '../components/ui/Reveal.astro'
import Tag from '../components/ui/Tag.astro'
import NextProject from '../components/case-study/NextProject.astro'
import ProjectSnapshot from '../components/case-study/ProjectSnapshot.astro'
import Lightbox from '../components/case-study/Lightbox.astro'
import SectionIndicator from '../components/case-study/SectionIndicator.astro'
import { resolveLocale, useTranslations } from '../i18n/ui'
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'case-studies'>
  next: CollectionEntry<'case-studies'>
}
const { entry, next } = Astro.props
const d = entry.data

// Case studies keep their brand colour. The global accent tokens default to
// neutral so the home page stays monochrome; this layout supplies a fallback
// for entries that don't declare one.
//
// These two hexes are COMPATIBILITY VALUES, not a chosen brand palette: they
// reproduce the pre-redesign global `--gradient-accent` default (blue fading to
// red) that brand-less case studies used to inherit from tokens.css. Don't treat
// them as a design decision — a case study that wants a real colour declares
// `brandColor` in its frontmatter.
const DEFAULT_CASE_STUDY_ACCENT = '#1E4FCF'
const DEFAULT_CASE_STUDY_ACCENT_ALT = '#DC2626'
const accent = d.brandColor ?? DEFAULT_CASE_STUDY_ACCENT
const accentAlt = d.brandColorAlt ?? (d.brandColor ? accent : DEFAULT_CASE_STUDY_ACCENT_ALT)

const lang = resolveLocale(Astro.currentLocale)
const t = useTranslations(lang)
---
<BaseLayout title={`${d.title}${t.caseStudy.titleSuffix}`} description={d.summary} ogImage={d.cover} showBackToHome>
  <style set:html={`
    :root{
      --color-accent: ${accent};
      --gradient-accent: linear-gradient(135deg, ${accent} 0%, ${accent} 60%, ${accentAlt} 100%);
    }
  `} />
  <article class="pt-12 md:pt-16">
    <Container>
      <div class="mx-auto w-full max-w-[1088px]">
        <Reveal>
          <header class="mt-8">
            <div class="mb-6 flex flex-wrap gap-2">{d.tags.map(t => <Tag>{t}</Tag>)}</div>
            <h1 class="font-display font-semibold text-display-xl text-text-primary">{d.title}</h1>
          </header>
        </Reveal>

        <Reveal delay={100}>
          <div class="mt-16 mb-16 overflow-hidden rounded-card bg-bg-secondary">
            <img
              src={d.cover}
              alt={d.coverAlt}
              class="block h-auto w-full grayscale transition duration-500 hover:grayscale-0"
            />
          </div>
        </Reveal>

        {d.snapshot && d.snapshot.length > 0 && <ProjectSnapshot items={d.snapshot} />}

        <slot />

        <NextProject slug={next.data.slug} title={next.data.title} cover={next.data.thumbnail} coverAlt={next.data.thumbnailAlt} />
      </div>
    </Container>
  </article>
  <SectionIndicator />
  <Lightbox />
</BaseLayout>
