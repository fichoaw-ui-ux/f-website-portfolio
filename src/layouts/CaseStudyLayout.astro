---
import BaseLayout from './BaseLayout.astro'
import Container from '../components/layout/Container.astro'
import Tag from '../components/ui/Tag.astro'
import NextProject from '../components/case-study/NextProject.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'case-studies'>
  next: CollectionEntry<'case-studies'>
}
const { entry, next } = Astro.props
const d = entry.data
---
<BaseLayout title={`${d.title} — Case Study`} description={d.summary} ogImage={d.cover} theme="light">
  <article class="pt-12">
    <Container>
      <a href="/#work" class="font-mono text-base text-text-secondary hover:text-text-primary transition">← Back to work</a>

      <header class="mt-8">
        <div class="flex flex-wrap gap-2 mb-6">{d.tags.map(t => <Tag>{t}</Tag>)}</div>
        <h1 class="font-display font-black text-display-xl max-w-4xl">{d.title}</h1>
        <div class="mt-8 flex flex-wrap gap-x-8 gap-y-2 font-mono text-base text-text-secondary">
          <div><span class="uppercase tracking-widest text-sm mr-2">Client</span>{d.client}</div>
          <div><span class="uppercase tracking-widest text-sm mr-2">Role</span>{d.role}</div>
          <div><span class="uppercase tracking-widest text-sm mr-2">Year</span>{d.year}</div>
          <div><span class="uppercase tracking-widest text-sm mr-2">Duration</span>{d.duration}</div>
        </div>
      </header>

      <div class="mt-12 rounded-lg overflow-hidden bg-bg-secondary">
        <img src={d.cover} alt={d.coverAlt} class="w-full h-auto max-h-[70vh] object-cover" />
      </div>

      <div class="mt-16 grid md:grid-cols-2 gap-12">
        <div>
          <div class="font-mono text-sm uppercase tracking-widest text-text-secondary mb-3">Overview</div>
          <p class="text-lg text-text-primary">{d.overview}</p>
        </div>
        <dl class="space-y-4 font-mono text-base">
          {d.team && d.team.length > 0 && (
            <div><dt class="uppercase tracking-widest text-sm text-text-secondary">Team</dt><dd class="mt-1">{d.team.join(', ')}</dd></div>
          )}
          <div><dt class="uppercase tracking-widest text-sm text-text-secondary">My Role</dt><dd class="mt-1">{d.role}</dd></div>
          <div><dt class="uppercase tracking-widest text-sm text-text-secondary">Deliverables</dt><dd class="mt-1">{d.deliverables.join(', ')}</dd></div>
          <div><dt class="uppercase tracking-widest text-sm text-text-secondary">Tools</dt><dd class="mt-1">{d.tools.join(', ')}</dd></div>
        </dl>
      </div>

      <div class="mt-8"><slot /></div>

      <NextProject slug={next.data.slug} title={next.data.title} cover={next.data.thumbnail} coverAlt={next.data.thumbnailAlt} />
    </Container>
  </article>
</BaseLayout>
