---
import '../styles/global.css'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import FooterRedesign from '../components/layout/FooterRedesign.astro'
import BackgroundVideo from '../components/layout/BackgroundVideo.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { resolveLocale } from '../i18n/ui'

interface Props {
  title: string
  description?: string
  ogImage?: string
  theme?: 'dark' | 'light'
  showHeader?: boolean
  showBackToHome?: boolean
  /** Redesigned page: uses the redesign footer (legacy pages keep the old one). */
  redesign?: boolean
}
const { title, description, ogImage = '/images/og-default.jpg', theme = 'dark', showHeader = true, showBackToHome = false, redesign = false } = Astro.props
const lang = resolveLocale(Astro.currentLocale)
const resolvedDescription = description ?? (lang === 'id' ? 'Portofolio Ficho — UI/UX Designer' : 'Portfolio of Ficho — UI/UX Designer')
const origin = Astro.site ?? new URL('https://ficho-portfolio.vercel.app')
const canonical = new URL(Astro.url.pathname, origin).toString()
// og:image must be absolute: Facebook, LinkedIn, Slack and X all discard a
// root-relative path, which is why link previews rendered without a card.
const ogImageUrl = new URL(ogImage, origin).toString()

// Strip the /id prefix (if present) to get the locale-agnostic path, then
// rebuild it for both locales — this is what the hreflang alternates point at.
const rawPath = lang === 'id' ? (Astro.url.pathname.replace(/^\/id/, '') || '/') : Astro.url.pathname
const hreflangId = new URL(getRelativeLocaleUrl('id', rawPath), origin).toString()
const hreflangEn = new URL(getRelativeLocaleUrl('en', rawPath), origin).toString()

/* Case study pages render light. This must override every colour token the
   shared chrome can reach, not just the ones the case-study body uses — the
   Header and Footer render on these pages too. An unmapped token silently
   falls through to its dark value, which is how `--color-border-hover` ended
   up as near-white-on-white here.
   Contrast on #FAFAFA: #0A0A0A 19.0:1, #525252 7.5:1, #6B6B6B 5.1:1. */
const lightThemeVars = [
  '--color-bg-primary: #FAFAFA',
  '--color-bg-secondary: #F0F0F0',
  '--color-bg-elevated: #E8E8E8',
  '--color-text-primary: #0A0A0A',
  '--color-text-secondary: #525252',
  '--color-text-tertiary: #6B6B6B',
  '--color-border: #E5E5E5',
  '--color-border-hover: #C4C4C4',
  '--color-glass: rgba(255, 255, 255, 0.7)',
  '--color-glass-border: rgba(0, 0, 0, 0.08)',
  '--color-glass-hover: rgba(255, 255, 255, 0.9)',
].join(';')
---
<!doctype html>
<html lang={lang} class="bg-bg-primary text-text-primary" style={theme === 'light' ? lightThemeVars : undefined} data-redesign={redesign ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Language switch (LanguageSwitch.astro stashes `langSwitchScroll` on
      // click). Runs before first paint:
      // - marks the landing page with data-lang-switch, so the compact header,
      //   tab bar and Reveal content show in their end state instead of
      //   animating in again (global.css, Reveal.astro, TabBar.astro);
      // - keeps the cross-page View Transition (global.css) for the language
      //   switch only: any other navigation skips it on both sides.
      (function () {
        var html = document.documentElement
        var switching = function () {
          try { return sessionStorage.getItem('langSwitchScroll') !== null } catch (e) { return false }
        }
        if (switching()) html.setAttribute('data-lang-switch', '')
        // Skipping rejects the transition's promises; catch them so a normal
        // navigation doesn't log "Transition was skipped".
        var skip = function (vt) {
          [vt.ready, vt.finished, vt.updateCallbackDone].forEach(function (p) {
            if (p) p.catch(function () {})
          })
          vt.skipTransition()
        }
        window.addEventListener('pageswap', function (e) {
          if (e.viewTransition && !switching()) skip(e.viewTransition)
        })
        window.addEventListener('pagereveal', function (e) {
          if (e.viewTransition && !html.hasAttribute('data-lang-switch')) skip(e.viewTransition)
        })
      })()
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The page sets its own colours; "only" stops browser auto dark modes
        (Chrome on Android, Samsung Internet) from recolouring components. */}
    <meta name="color-scheme" content={`only ${theme}`} />
    <title>{title}</title>
    <meta name="description" content={resolvedDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="id" href={hreflangId} />
    <link rel="alternate" hreflang="en" href={hreflangEn} />
    <link rel="alternate" hreflang="x-default" href={hreflangEn} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-bg-primary text-text-primary">
    {theme === 'dark' && <BackgroundVideo />}
    {showHeader && <Header showBackToHome={showBackToHome} overVideo={theme === 'dark'} />}
    <main><slot /></main>
    {redesign ? <FooterRedesign /> : <Footer />}
    <script is:inline>
      // Counterpart to the stash in LanguageSwitch.astro — restores the scroll
      // position after the language-switch navigation lands here. The two
      // languages differ in copy length, so the position is kept relative to
      // the section that was at the top (same id in both), not as raw pixels.
      (function () {
        var raw
        try { raw = sessionStorage.getItem('langSwitchScroll') } catch (e) { return }
        if (raw === null) return
        sessionStorage.removeItem('langSwitchScroll')
        var s
        try { s = JSON.parse(raw) } catch (e) { return }
        var anchor = s.id && document.getElementById(s.id)
        var top = anchor ? anchor.getBoundingClientRect().top + window.scrollY + s.offset : s.y
        // `behavior: 'instant'` bypasses the global `scroll-behavior: smooth`
        // (global.css) — without it this animates from the top.
        window.scrollTo({ top: top, left: 0, behavior: 'instant' })
        // The header/tab bar/Reveal scripts (module scripts) have set their
        // state by DOMContentLoaded; after two frames, normal animation
        // resumes. The timer covers tabs that draw no frames (background tabs).
        document.addEventListener('DOMContentLoaded', function () {
          var done = function () { document.documentElement.removeAttribute('data-lang-switch') }
          requestAnimationFrame(function () { requestAnimationFrame(done) })
          setTimeout(done, 150)
        })
      })()
    </script>
  </body>
</html>
